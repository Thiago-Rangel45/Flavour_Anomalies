    "print(\"\\n=======================================================\")\n",
    "print(f\"Melhor Significância de Punzi (WP Opt): {study.best_value:.4f}\")\n",
    "print(\"Hiperparâmetros Ótimos Selecionados:\")\n",
    "for key, value in study.best_params.items():\n",
    "    print(f\"  {key}: {value}\")\n",
    "print(\"=======================================================\\n\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "3b53350a-66f4-4e07-ac43-af37abef0c1c",
   "metadata": {},
   "outputs": [],
   "source": [
    "best_params = study.best_params\n",
    "best_params['objective'] = 'binary:logistic'\n",
    "best_params['eval_metric'] = ['logloss', 'auc']\n",
    "best_params['random_state'] = 42\n",
    "best_params['n_jobs'] = -1"
   ]
  },
  {
   "cell_type": "code",
