   "metadata": {},
   "outputs": [],
   "source": [
    "features = [\n",
    "    'BToTrkTrkMuMu_l_xy_sig', 'BToTrkTrkMuMu_dca_sig', \n",
    "    'BToTrkTrkMuMu_trk1_dca_sig', 'BToTrkTrkMuMu_trk2_dca_sig', \"BToTrkTrkMuMu_fit_ditrack_mass_Kpi\",\n",
    "    'BToTrkTrkMuMu_fit_pt', 'BToTrkTrkMuMu_fit_cos2D', 'BToTrkTrkMuMu_svprob'\n",
    "]"
   ]
  },
  {
