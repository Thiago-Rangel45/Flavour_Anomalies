    "sampler = TPESampler(seed=42)\n",
    "study = optuna.create_study(direction='maximize', sampler=sampler)\n",
    "study.optimize(lambda trial: objective(trial, df_total, features), n_trials=150, show_progress_bar=True)"
   ]
