   "source": [
    "pu_weight_arr = np.load(\"/eos/user/t/tdeandra/SWAN_projects/BPH_Analysis/MC_Analysis/Pileup_Correction/mc_weight.npy\")\n",
    "\n",
    "bins       = np.floor(df_mc['Pileup_nTrueInt'] + 0.5).astype(int)\n",
    "valid_mask = (bins >= 0) & (bins < len(pu_weight_arr))\n",
    "\n",
    "df_mc['pu_weight'] = 1.0\n",
    "df_mc.loc[valid_mask, 'pu_weight'] = pu_weight_arr[bins[valid_mask]]\n",
    "df_mc = df_mc.drop(columns=['Pileup_nTrueInt'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "4da0087f-7483-4f85-b45f-920bf799410c",
