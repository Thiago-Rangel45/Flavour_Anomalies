   "source": [
    "study = optuna.create_study(direction='minimize', sampler=optuna.samplers.TPESampler(seed=42))\n",
    "study.optimize(lambda trial: objective(trial, X, y, w, f), n_trials=200, show_progress_bar=True)"
   ]
  },
