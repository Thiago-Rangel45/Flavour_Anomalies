    "print(f\"\\nEventos de background (sidebands): {len(df_data)}\")\n",
    "print(f\"Eventos de sinal (MC truth):        {len(df_mc)}\")\n",
    "print(f\"Razao bkg/sig: {len(df_data)/len(df_mc):.1f}\")"
   ]
