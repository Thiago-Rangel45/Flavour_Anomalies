    "tree_path = \"Events\"\n",
    "data_files = {f: tree_path for f in [\n",
    "    \"/eos/user/t/tdeandra/skim_outputs/Merged_Eras/Merged_dados_Run2022C.root\",\n",
    "    \"/eos/user/t/tdeandra/skim_outputs/Merged_Eras/Merged_dados_Run2022D.root\",\n",
