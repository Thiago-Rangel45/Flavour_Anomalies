   "source": [
    "meus_modelos = {}\n",
    "\n",
    "for i in range(5):\n",
    "    nome_arquivo = f\"xgboost_fold_{i}.joblib\"\n",
    "    caminho_completo = os.path.join(\"bdt_models_final\", nome_arquivo)    \n",
    "    meus_modelos[f\"modelo_{i}\"] = joblib.load(caminho_completo)"
   ]
  },
