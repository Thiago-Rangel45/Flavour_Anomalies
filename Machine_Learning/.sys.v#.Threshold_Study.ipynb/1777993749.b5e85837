    "    mass_min_rsb, mass_max_rsb = 5.416657231, 5.6\n",
    "    \n",
    "    obs_lsb = zfit.Space(\"BToTrkTrkMuMu_fit_mass_Kpi\", limits=(mass_min_lsb, mass_max_lsb))\n",
