    "            lw=0, \n",
    "            alpha=0.7)\n",
    "\n",
    "# Plotar a MÉDIA\n",
    "ax.plot(all_cuts, fom_mean, \n",
    "        label=\"MÉDIA (5 Folds)\", \n",
