   "source": [
    "plt.figure(figsize=(8, 6))\n",
    "\n",
    "# 1. Plotamos o MC 2022 como histograma normal e guardamos as bordas dos bins\n",
    "counts_mc, bins_mc, _ = plt.hist(\n",
    "    df_data['bdt_score'], \n",
    "    bins=50, \n",
    "    alpha=0.8, \n",
    "    label='MC 2022', \n",
    "    density=True,\n",
    "    color='tab:blue' # Fixando uma cor para ficar mais bonito\n",
    ")\n",
    "\n",
    "# 2. Calculamos os valores para o MC 2022 EE usando exatamente os mesmos bins\n",
    "counts_ee, _ = np.histogram(df_data_EE['bdt_score'], bins=bins_mc, density=True)\n",
    "\n",
    "# Encontramos o centro de cada bin para posicionar os pontos\n",
    "bin_centers = (bins_mc[:-1] + bins_mc[1:]) / 2\n",
    "\n",
    "# 3. Plotamos o MC 2022 EE como pontos\n",
    "plt.plot(\n",
    "    bin_centers, \n",
    "    counts_ee, \n",
    "    marker='o',         # Formato do ponto (círculo)\n",
    "    linestyle='none',   # Sem linha conectando os pontos\n",
    "    color='black',      # Cor do ponto\n",
    "    label='MC 2022 EE'\n",
    ")\n",
    "\n",
    "plt.xlabel('BDT Score', fontsize=14)\n",
    "# Mudei o label do eixo Y porque density=True plota densidade, não a contagem absoluta de eventos\n",
    "plt.ylabel('Densidade de Eventos', fontsize=14) \n",
    "plt.title(' ', fontsize=16)\n",
    "\n",
    "plt.legend()\n",
    "plt.yscale('log')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "plt.close()"
   ]
  },
