   "id": "6607e28a-2d0d-4cfd-afc6-0c96d6be46f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "probabilities = model.predict_proba(df_data.drop(columns=[\"BToTrkTrkMuMu_fit_mass_Kpi\"]))[:, 1]\n",
    "predictions = model.predict(df_data.drop(columns=[\"BToTrkTrkMuMu_fit_mass_Kpi\"]))\n",
    "\n",
    "probabilities_EE = model.predict_proba(df_data_EE.drop(columns=[\"BToTrkTrkMuMu_fit_mass_Kpi\"]))[:, 1]\n",
    "predictions_EE = model.predict(df_data_EE.drop(columns=[\"BToTrkTrkMuMu_fit_mass_Kpi\"]))\n",
    "\n",
    "df_data['bdt_score'] = probabilities\n",
    "df_data['bdt_prediction'] = predictions\n",
    "\n",
    "df_data_EE['bdt_score'] = probabilities_EE\n",
    "df_data_EE['bdt_prediction'] = predictions_EE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "47b56103-cfb0-4600-b591-23344904cc8d",
