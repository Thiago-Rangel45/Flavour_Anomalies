   "source": [
    "random_search.fit(X_train, y_train, sample_weight=w_train)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d140ba8e-a703-4f5c-977c-9b3b97e20d3f",
   "metadata": {},
   "outputs": [],
   "source": [
    "best_params = random_search.best_params_\n",
    "print(f\"\\nMelhores params: {best_params}\")\n",
    "print(f\"AUC CV:          {random_search.best_score_:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "56fb2952-f6d5-400d-b24c-7a5f505e9408",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "cv_roc  = StratifiedKFold(n_splits=10, shuffle=True, random_state=42)\n",
    "tprs    = []\n",
    "aucs_cv = []\n",
    "mean_fpr = np.linspace(0, 1, 100)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "\n",
    "for fold, (tr_idx, val_idx) in enumerate(cv_roc.split(X_train, y_train)):\n",
    "    X_f_tr, X_f_val = X_train[tr_idx], X_train[val_idx]\n",
    "    y_f_tr, y_f_val = y_train[tr_idx], y_train[val_idx]\n",
    "    w_f_tr          = w_train[tr_idx]\n",
    "\n",
    "    model_fold = xgb.XGBClassifier(\n",
    "        **best_params,\n",
    "        objective='binary:logistic',\n",
    "        tree_method='hist',\n",
    "        eval_metric='auc',\n",
    "        random_state=42,\n",
    "        n_jobs=-1,\n",
    "    )\n",
    "    model_fold.fit(X_f_tr, y_f_tr, sample_weight=w_f_tr, verbose=False)\n",
    "\n",
    "    y_prob_fold = model_fold.predict_proba(X_f_val)[:, 1]\n",
    "    fpr_f, tpr_f, _ = roc_curve(y_f_val, y_prob_fold)\n",
    "    auc_fold = auc(fpr_f, tpr_f)\n",
    "\n",
    "    ax.plot(fpr_f, tpr_f, lw=1, alpha=0.3,\n",
    "            label=f\"Fold {fold} (AUC = {auc_fold:.3f})\")\n",
    "\n",
    "    interp_tpr = np.interp(mean_fpr, fpr_f, tpr_f)\n",
    "    interp_tpr[0] = 0.0\n",
    "    tprs.append(interp_tpr)\n",
    "    aucs_cv.append(auc_fold)\n",
    "\n",
    "# Curva média\n",
    "mean_tpr      = np.mean(tprs, axis=0)\n",
    "mean_tpr[-1]  = 1.0\n",
    "#mean_auc      = auc(mean_fpr, mean_tpr)\n",
    "mean_auc = np.mean(aucs_cv)\n",
    "std_auc       = np.std(aucs_cv)\n",
    "std_tpr       = np.std(tprs, axis=0)\n",
    "\n",
    "ax.plot([0, 1], [0, 1], linestyle='--', lw=2, color='black', label='Acaso', alpha=0.8)\n",
    "ax.plot(mean_fpr, mean_tpr, color='blue', lw=2.5,\n",
    "        label=rf\"ROC Média (AUC = {mean_auc:.3f} $\\pm$ {std_auc:.3f})\")\n",
    "ax.fill_between(mean_fpr,\n",
    "                np.maximum(mean_tpr - std_tpr, 0),\n",
    "                np.minimum(mean_tpr + std_tpr, 1),\n",
    "                color='grey', alpha=0.2, label=r\"$\\pm$ 1 desvio padrão\")\n",
    "\n",
    "ax.set_xlim([0.0, 1.0])\n",
    "ax.set_ylim([0.0, 1.05])\n",
    "ax.set_xlabel(\"Eficiência de Background (FPR)\")\n",
    "ax.set_ylabel(\"Eficiência de Sinal (TPR)\")\n",
    "ax.legend(loc='lower right', fontsize=10, ncol=2)\n",
    "hep.cms.label(data=True, label=\"Work in Progress\", year=\"2022\",\n",
    "              lumi=31.69, loc=0, ax=ax, com=13.6)\n",
    "plt.tight_layout()\n",
    "os.makedirs(\"PlotsEE\", exist_ok=True)\n",
    "plt.savefig(\"PlotsEE/ROC_curve_cv.png\", dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "10df37f1-4053-4fdf-a4e4-419bb48aae0a",
   "metadata": {},
   "outputs": [],
   "source": [
    "model_final = xgb.XGBClassifier(\n",
    "    **best_params,\n",
    "    objective='binary:logistic',\n",
    "    tree_method='hist',\n",
    "    eval_metric=['auc', 'logloss'],\n",
    "    early_stopping_rounds=20,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "163ad387-1559-4497-9c46-10e458a91011",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "model_final.fit(\n",
    "    X_train, y_train,\n",
    "    sample_weight=w_train,\n",
    "    eval_set=[(X_train, y_train), (X_val, y_val)],  # ← treino E val\n",
    "    sample_weight_eval_set=[w_train, w_val],\n",
    "    verbose=50,\n",
    ")\n",
    "\n",
    "print(f\"\\nMelhor iteração (early stop): {model_final.best_iteration}\")\n",
    "print(f\"Melhor AUC no val:            {model_final.best_score:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ae8a5bd4-88a0-4011-88de-9a124032ed71",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Extração dos resultados de evolução\n",
    "results = model_final.evals_result()\n",
    "epochs = len(results['validation_0']['logloss'])\n",
    "x_axis_pct = np.linspace(0, 100, epochs)\n",
    "\n",
    "# 3. Plotagem da Evolução (LogLoss e AUC de Treino vs Validação)\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7))\n",
    "\n",
    "# LogLoss\n",
    "ax1.plot(x_axis_pct, results['validation_0']['logloss'], label='Training', color='red', lw=2)\n",
    "ax1.plot(x_axis_pct, results['validation_1']['logloss'], label='Validation (Early Stop)', color='green', lw=2, linestyle='--')\n",
    "ax1.set_ylabel('Log Loss')\n",
    "ax1.set_xlabel('% Number of Trees')\n",
    "ax1.legend()\n",
    "hep.cms.label(data=True, label=\"Work in Progress\", year=\"2022\", lumi=31.69, ax=ax1, com=13.6, fontsize=20)\n",
    "\n",
    "# AUC Evolução\n",
    "ax2.plot(x_axis_pct, results['validation_0']['auc'], label='Training', color='red', lw=2)\n",
    "ax2.plot(x_axis_pct, results['validation_1']['auc'], label='Validation (Early Stop)', color='green', lw=2, linestyle='--')\n",
    "ax2.set_ylabel('ROC AUC')\n",
    "ax2.set_xlabel('% Number of Trees')\n",
    "ax2.legend(loc='lower right')\n",
    "hep.cms.label(data=True, label=\"Work in Progress\", year=\"2022\", lumi=31.69, ax=ax2, com =13.6, fontsize=20)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"PlotsEE/Logloss_and_ROC_AUC_validation.png\")\n",
    "plt.show()\n",
    "\n",
    "print(f\"Treinamento finalizado na iteração: {model_final.best_iteration}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "639890e0-dce1-4597-8279-fc1f37517dd7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Previsões para o Teste Cego\n",
    "y_pred_prob_train = model_final.predict_proba(X_train)[:, 1]\n",
    "y_pred_prob_test  = model_final.predict_proba(X_test)[:, 1]\n",
    "\n",
    "# 2. Cálculos das Métricas Finais (ROC e PR)\n",
    "# --- ROC ---\n",
    "fpr_train, tpr_train, _ = roc_curve(y_train, y_pred_prob_train)\n",
    "roc_auc_train = auc(fpr_train, tpr_train)\n",
    "\n",
    "fpr_test, tpr_test, _ = roc_curve(y_test, y_pred_prob_test)\n",
    "roc_auc_test = auc(fpr_test, tpr_test)\n",
    "\n",
    "# --- Precision-Recall (Calculando ambos agora) ---\n",
    "precision_train, recall_train, _ = precision_recall_curve(y_train, y_pred_prob_train)\n",
    "pr_auc_train = auc(recall_train, precision_train)\n",
    "\n",
    "precision_test, recall_test, _ = precision_recall_curve(y_test, y_pred_prob_test)\n",
    "pr_auc_test = auc(recall_test, precision_test)\n",
    "\n",
    "# 3. Plotagem das Curvas de Performance (ROC e Precision-Recall)\n",
    "fig, (ax3, ax4) = plt.subplots(1, 2, figsize=(16, 7))\n",
    "\n",
    "# --- Curva ROC Final (ax3) ---\n",
    "ax3.plot(fpr_train, tpr_train, color='red', lw=2, \n",
    "         label=f'Training (AUC = {roc_auc_train:.4f})')\n",
    "ax3.plot(fpr_test, tpr_test, color='blue', lw=2, \n",
    "         label=f'Test (AUC = {roc_auc_test:.4f})')\n",
    "ax3.plot([0, 1], [0, 1], color='black', linestyle=':', label='Random')\n",
    "ax3.set_xlabel('FPR (Background Efficiency)', fontsize = 20)\n",
    "ax3.set_ylabel('TPR (Signal Efficiency)', fontsize = 20)\n",
    "ax3.legend(loc='lower right', fontsize=12)\n",
    "hep.cms.label(data=True, label=\"Work in Progress\", year=\"2022\", lumi=31.69, ax=ax3, com=13.6, fontsize = 20)\n",
    "\n",
    "# --- Curva Precision-Recall Final (ax4) ---\n",
    "ax4.plot(recall_train, precision_train, color='red', lw=2, \n",
    "         label=f'Training (AUC = {pr_auc_train:.4f})')\n",
    "ax4.plot(recall_test, precision_test, color='blue', lw=2, \n",
    "         label=f'Test (AUC = {pr_auc_test:.4f})')\n",
    "ax4.set_xlabel('Recall (Signal Efficiency)', fontsize = 20)\n",
    "ax4.set_ylabel('Precision (Signal Purity)', fontsize = 20)\n",
    "ax4.legend(loc='lower left', fontsize=12)\n",
    "hep.cms.label(data=True, label=\"Work in Progress\", year=\"2022\", lumi=31.69, ax=ax4, com=13.6, fontsize = 20)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"PlotsEE/ROC_and_PR_teste.png\")\n",
    "plt.show()\n",
    "\n",
    "print(f\"AUC ROC Teste: {roc_auc_test:.4f} | PR AUC Teste: {pr_auc_test:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1fce0ece-7867-4a99-ac53-68a054fbbc28",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay, classification_report, accuracy_score, f1_score\n",
    "import matplotlib.pyplot as plt\n",
    "import mplhep as hep\n",
    "\n",
    "y_test_pred = (y_pred_prob_test > 0.5).astype(int)\n",
    "cm = confusion_matrix(y_test, y_test_pred)\n",
    "cm_norm = confusion_matrix(y_test, y_test_pred, normalize='true')\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(25, 10))\n",
    "\n",
    "# Matriz absoluta\n",
    "disp1 = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=[\"Background\", \"Signal\"])\n",
    "disp1.plot(ax=ax1, cmap='Blues', values_format='d')\n",
    "ax1.set_title(\"\", fontsize=20, pad=20)\n",
    "\n",
    "# Matriz normalizada\n",
    "disp2 = ConfusionMatrixDisplay(confusion_matrix=cm_norm, display_labels=[\"Background\", \"Signal\"])\n",
    "disp2.plot(ax=ax2, cmap='Blues', values_format='.2f')\n",
    "ax2.set_title(\"\", fontsize=20, pad=20)\n",
    "\n",
    "for ax in [ax1, ax2]:\n",
    "    hep.cms.label(ax=ax, label=\"Work in Progress\", data=True, lumi=31.69, year=\"2022\", com=13.6, fontsize=20)\n",
    "    ax.set_xlabel('Predicted Label', fontsize=35)\n",
    "    ax.set_ylabel('True Label', fontsize=35)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"PlotsEE/final_confusion_matrix_TEST.png\", dpi=100, bbox_inches='tight')\n",
    "print(f\"Matriz de confusão salva em: PlotsEE/final_confusion_matrix_TEST.png\")\n",
    "plt.show()\n",
    "\n",
    "print(classification_report(y_test, y_test_pred, target_names=['Background', 'Signal'], digits=4))\n",
    "print(f\"Accuracy: {accuracy_score(y_test, y_test_pred):.4f}\")\n",
    "print(f\"F1-Score: {f1_score(y_test, y_test_pred):.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "543789be-9001-46f1-ad5b-5f4ffb1062fd",
   "metadata": {},
   "outputs": [],
   "source": [
    "labels_dict = {\n",
    "    'BToTrkTrkMuMu_l_xy_sig': r'$L_{BS} / \\sigma_{L}$',\n",
    "    'BToTrkTrkMuMu_dca_sig': r'$B^{0}$ DCA Significance',\n",
    "    'BToTrkTrkMuMu_trk1_dca_sig': r'$Track^{+}$ DCA Significance',\n",
    "    'BToTrkTrkMuMu_trk2_dca_sig': r'$Track^{-}$ DCA Significance',\n",
    "    'BToTrkTrkMuMu_fit_ditrack_mass_Kpi': r'$m(K^{+}\\pi^{-})$',\n",
    "    'BToTrkTrkMuMu_fit_pt': r'$p_T(B^{0})$',\n",
    "    'BToTrkTrkMuMu_fit_cos2D': r'$\\cos(\\alpha_{2D})$',\n",
    "    'BToTrkTrkMuMu_svprob': 'SV Fit Probability'\n",
    "}\n",
    "\n",
    "imp_type = 'weight' \n",
    "fig, ax = plt.subplots(figsize=(12, 9)) \n",
    "\n",
    "importance = model_final.get_booster().get_score(importance_type=imp_type)\n",
    "imp_df = pd.DataFrame.from_dict(importance, orient='index', columns=[imp_type])\n",
    "\n",
    "imp_df['PrettyLabel'] = [labels_dict.get(name, name) for name in imp_df.index]\n",
    "max_val = imp_df[imp_type].max()\n",
    "imp_df['Normalized'] = imp_df[imp_type] / max_val if max_val > 0 else 0\n",
    "\n",
    "imp_df = imp_df.sort_values('Normalized', ascending=True)\n",
    "\n",
    "bars = ax.barh(imp_df['PrettyLabel'], imp_df['Normalized'], color='lightsteelblue', edgecolor='black', height=0.7)\n",
    "\n",
    "for bar in bars:\n",
    "    width = bar.get_width()\n",
    "    ax.text(width + 0.02, bar.get_y() + bar.get_height()/2, f'{width:.3f}', va='center', color='black', \n",
    "            fontsize=14, fontweight='bold')\n",
    "\n",
    "ax.set_xlabel(\"Normalized Importance (Weight)\", fontsize=22)\n",
    "ax.set_xlim(0, 1.2) \n",
    "ax.tick_params(axis='both', labelsize=16)\n",
    "hep.cms.label(ax=ax, label=\"Work in Progress\", data=True, lumi=31.69, year=\"2022\", com=13.6, fontsize=19)\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig('PlotsEE/feature_importances_pretty.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ed826a66-c9df-471c-9a17-ce4b52f27a68",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import mplhep as hep\n",
    "\n",
    "labels_dict = {\n",
    "    'BToTrkTrkMuMu_l_xy_sig': r'$L_{BS} / \\sigma_{L}$',\n",
    "    'BToTrkTrkMuMu_dca_sig': r'$B^{0}$ DCA Significance',\n",
    "    'BToTrkTrkMuMu_trk1_dca_sig': r'$Track^{+}$ DCA Significance',\n",
    "    'BToTrkTrkMuMu_trk2_dca_sig': r'$Track^{-}$ DCA Significance',\n",
    "    'BToTrkTrkMuMu_fit_ditrack_mass_Kpi': r'$m(K^{+}\\pi^{-})$',\n",
    "    'BToTrkTrkMuMu_fit_pt': r'$p_T(B^{0})$',\n",
    "    'BToTrkTrkMuMu_fit_cos2D': r'$\\cos(\\alpha_{2D})$',\n",
    "    'BToTrkTrkMuMu_svprob': 'SV Fit Probability'\n",
    "}\n",
    "\n",
    "# 1. Defina a lista de features na MESMA ORDEM usada no X_train\n",
    "# Se a ordem do dicionário for exatamente a ordem do treino, você pode usar:\n",
    "feature_names = list(labels_dict.keys())\n",
    "\n",
    "# 2. Atribua os nomes ao booster ANTES de puxar o score\n",
    "model_final.get_booster().feature_names = feature_names\n",
    "\n",
    "imp_type = 'weight' \n",
    "fig, ax = plt.subplots(figsize=(12, 9)) \n",
    "\n",
    "# Agora o dicionário 'importance' virá com os nomes reais em vez de f0, f1...\n",
    "importance = model_final.get_booster().get_score(importance_type=imp_type)\n",
    "imp_df = pd.DataFrame.from_dict(importance, orient='index', columns=[imp_type])\n",
    "\n",
    "# Como os nomes agora estão corretos, o .get() vai encontrar o LaTeX certinho\n",
    "imp_df['PrettyLabel'] = [labels_dict.get(name, name) for name in imp_df.index]\n",
    "\n",
    "max_val = imp_df[imp_type].max()\n",
    "imp_df['Normalized'] = imp_df[imp_type] / max_val if max_val > 0 else 0\n",
    "\n",
    "imp_df = imp_df.sort_values('Normalized', ascending=True)\n",
    "\n",
    "bars = ax.barh(imp_df['PrettyLabel'], imp_df['Normalized'], color='lightsteelblue', edgecolor='black', height=0.7)\n",
    "\n",
    "for bar in bars:\n",
    "    width = bar.get_width()\n",
    "    ax.text(width + 0.02, bar.get_y() + bar.get_height()/2, f'{width:.3f}', va='center', color='black', \n",
    "            fontsize=14, fontweight='bold')\n",
    "\n",
    "ax.set_xlabel(\"Normalized Importance (Weight)\", fontsize=22)\n",
    "ax.set_xlim(0, 1.2) \n",
    "ax.tick_params(axis='both', labelsize=16)\n",
    "hep.cms.label(ax=ax, label=\"Work in Progress\", data=True, lumi=31.69, year=\"2022\", com=13.6, fontsize=19)\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig('PlotsEE/feature_importances_pretty.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3dd97ce4-ed79-4be7-abb5-8e247ac8e532",
   "metadata": {},
   "outputs": [],
   "source": [
    "y_probs_train = model_final.predict_proba(X_train)[:, 1]\n",
    "y_probs_test = model_final.predict_proba(X_test)[:, 1]\n",
    "\n",
    "sig_train = y_probs_train[y_train == 1]\n",
    "bkg_train = y_probs_train[y_train == 0]\n",
    "sig_test = y_probs_test[y_test == 1]\n",
    "bkg_test = y_probs_test[y_test == 0]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7, 6))\n",
    "bins = np.linspace(0, 1, 40)\n",
    "bin_centers = 0.5 * (bins[:-1] + bins[1:])\n",
    "\n",
    "\n",
    "h_bkg_train, _ = np.histogram(bkg_train, bins=bins, density=True)\n",
    "hep.histplot(h_bkg_train, bins=bins, ax=ax, color='red', alpha=0.4, histtype='fill', label='Bkg Train')\n",
    "\n",
    "h_bkg_test_counts, _ = np.histogram(bkg_test, bins=bins) # Contagens puras para o erro\n",
    "h_bkg_test_dens, _   = np.histogram(bkg_test, bins=bins, density=True) # Densidade para o plot\n",
    "\n",
    "scale_bkg = np.divide(h_bkg_test_dens, h_bkg_test_counts, out=np.zeros_like(h_bkg_test_dens), where=h_bkg_test_counts!=0)\n",
    "error_bkg = np.sqrt(h_bkg_test_counts) * scale_bkg\n",
    "ax.errorbar(bin_centers, h_bkg_test_dens, yerr=error_bkg, fmt='o', color='red', markersize=4, label=f'Bkg Test')\n",
    "\n",
    "h_sig_train, _ = np.histogram(sig_train, bins=bins, density=True)\n",
    "\n",
    "hep.histplot(h_sig_train, bins=bins, ax=ax, color='blue', linewidth=2, histtype='step', \n",
    "        label='Sig Train')\n",
    "\n",
    "# B) Teste\n",
    "h_sig_test_counts, _ = np.histogram(sig_test, bins=bins)\n",
    "h_sig_test_dens, _   = np.histogram(sig_test, bins=bins, density=True)\n",
    "\n",
    "scale_sig = np.divide(h_sig_test_dens, h_sig_test_counts, out=np.zeros_like(h_sig_test_dens), where=h_sig_test_counts!=0)\n",
    "error_sig = np.sqrt(h_sig_test_counts) * scale_sig\n",
    "\n",
    "ax.errorbar(bin_centers, h_sig_test_dens, yerr=error_sig, fmt='o', color='blue', markersize=4, label=f'Sig Test')\n",
    "\n",
    "\n",
    "ax.set_yscale('log')\n",
    "max_y = max(h_sig_train.max(), h_bkg_train.max())\n",
    "ax.set_ylim(bottom=1e-3, top=max_y * 50) \n",
    "ax.set_xlim(0, 1)\n",
    "\n",
    "ax.set_xlabel(\"BDT Output Score\", fontsize=14)\n",
    "ax.set_ylabel(\"a.u\", fontsize=16)\n",
    "ax.legend(loc='upper center', fontsize=12, ncol=2)\n",
    "hep.cms.label(ax=ax, label=\"Work in Progress\", data=True, lumi=31.69, year=\"2022\", com=13.6, fontsize=14)\n",
    "    \n",
    "plt.tight_layout()\n",
    "plt.savefig(\"PlotsEE/overtraining_check.png\")\n",
    "plt.show()"
   ]
  },
