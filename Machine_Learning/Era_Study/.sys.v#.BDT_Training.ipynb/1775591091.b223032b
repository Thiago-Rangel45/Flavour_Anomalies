   "id": "46d0960e-4ef2-43f1-9725-5cc401d310ef",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_data[features] = df_data[features].replace([np.inf, -np.inf], np.nan)\n",
    "df_data = df_data.dropna(subset=features)\n",
    "\n",
    "df_mc[features] = df_mc[features].replace([np.inf, -np.inf], np.nan)\n",
    "df_mc = df_mc.dropna(subset=features)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "47122e20-ac06-4853-8b6d-51b1814a8e1a",
   "metadata": {},
   "outputs": [],
   "source": [
    "scale_mc = df_data['pu_weight'].sum() / df_mc['pu_weight'].sum()\n",
    "df_data['sample_weight'] = df_data['pu_weight']\n",
    "df_mc['sample_weight']   = df_mc['pu_weight'] * scale_mc\n",
    "\n",
    "df_all = pd.concat([df_data, df_mc], ignore_index=True)"
   ]
  },
