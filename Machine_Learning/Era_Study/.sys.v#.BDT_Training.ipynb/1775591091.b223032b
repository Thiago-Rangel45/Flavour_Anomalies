   ],
   "source": [
    "X_temp, X_test, y_temp, y_test, w_temp, w_test = train_test_split(\n",
    "    X, y, w, test_size=0.20, random_state=42, stratify=y\n",
    ")\n",
    "X_train, X_val, y_train, y_val, w_train, w_val = train_test_split(\n",
    "    X_temp, y_temp, w_temp, test_size=0.25, random_state=42, stratify=y_temp\n",
    ")  # 0.25 × 0.80 = 0.20\n",
    "\n",
    "print(f\"\\nTreino: {len(X_train)} | Val: {len(X_val)} | Teste: {len(X_test)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "52ca6cb3-1bc7-48be-8270-c762a09814a3",
   "metadata": {},
   "outputs": [],
   "source": [
    "xgb_base = xgb.XGBClassifier(\n",
    "    tree_method=\"hist\", \n",
    "    device=\"cuda\",\n",
    "    objective='binary:logistic', \n",
    "    random_state=42\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "107758e5-eb1a-46d1-b2b8-225d7bc5a439",
   "metadata": {},
   "outputs": [],
   "source": [
    "param_grid = {\n",
    "    'n_estimators':     [200, 300, 400, 500, 600, 1000],\n",
    "    'max_depth':        [3, 4, 5, 6],\n",
    "    'learning_rate':    [0.01, 0.05, 0.1],\n",
    "    'subsample':        [0.6, 0.8, 1.0],\n",
    "    'colsample_bytree': [0.6, 0.8, 1.0],\n",
    "    'min_child_weight': [1, 3, 5],\n",
    "    'reg_alpha':        [0.0, 0.1, 1.0],\n",
    "    'reg_lambda':       [0.5, 1.0, 5.0]\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "fd1dcf71-07f0-4d94-835b-a41a26e4161f",
   "metadata": {},
   "outputs": [],
   "source": [
    "custom_auc_scorer = make_scorer(roc_auc_score, response_method=\"predict_proba\")\n",
    "\n",
    "random_search = RandomizedSearchCV(\n",
    "    estimator=xgb_base,\n",
    "    param_distributions=param_grid,\n",
    "    n_iter=100,          \n",
    "    scoring=\"roc_auc\",\n",
    "    cv=5,                \n",
    "    verbose=2,\n",
    "    random_state=42,\n",
    "    n_jobs=4             \n",
    ")"
   ]
  },
