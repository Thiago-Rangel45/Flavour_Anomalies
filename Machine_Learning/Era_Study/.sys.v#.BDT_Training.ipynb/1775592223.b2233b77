   "source": [
    "pu_weight_arr = np.load(\"/eos/user/t/tdeandra/SWAN_projects/BPH_Analysis/MC_Analysis/Pileup_Correction/mc_weight.npy\")\n",
    "\n",
    "bins       = np.floor(df_mc['Pileup_nTrueInt'] + 0.5).astype(int)\n",
    "valid_mask = (bins >= 0) & (bins < len(pu_weight_arr))\n",
    "\n",
    "df_mc['pu_weight'] = 1.0\n",
    "df_mc.loc[valid_mask, 'pu_weight'] = pu_weight_arr[bins[valid_mask]]\n",
    "df_data['pu_weight'] = 1.0\n",
    "\n",
    "df_mc = df_mc.drop(columns=['Pileup_nTrueInt'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "5b5fbd18-fc0e-4e7d-9eed-65cb433c0c1c",
   "metadata": {},
   "outputs": [],
   "source": [
    "features = [\n",
    "    'BToTrkTrkMuMu_l_xy_sig',\n",
    "    'BToTrkTrkMuMu_dca_sig',\n",
    "    'BToTrkTrkMuMu_trk1_dca_sig',\n",
    "    'BToTrkTrkMuMu_trk2_dca_sig',\n",
    "    'BToTrkTrkMuMu_fit_ditrack_mass_Kpi',\n",
    "    'BToTrkTrkMuMu_fit_pt',\n",
    "    'BToTrkTrkMuMu_fit_cos2D',\n",
    "    'BToTrkTrkMuMu_svprob',\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "472c1a8a-9add-4f6b-b625-74f6c673b7ec",
   "metadata": {},
