    "\n",
    "ax4.plot(recall_train, precision_train, color='red', lw=2, label=f'Training (AUC = {pr_auc_train:.4f})')\n",
    "ax4.plot(recall_test, precision_test, color='blue', lw=2, label=f'Test (AUC = {pr_auc_test:.4f})')\n",
