    "labels_dict = {\n",
    "    'BToTrkTrkMuMu_l_xy_sig': r'$L_{BS} / \\sigma_{L}$',\n",
    "    'BToTrkTrkMuMu_dca_sig': r'$B^{0}$ DCA Significance',\n",
    "    'BToTrkTrkMuMu_trk1_dca_sig': r'$Track^{+}$ DCA Significance',\n",
    "    'BToTrkTrkMuMu_trk2_dca_sig': r'$Track^{-}$ DCA Significance',\n",
    "    'BToTrkTrkMuMu_fit_ditrack_mass_Kpi': r'$m(K^{+}\\pi^{-})$',\n",
    "    'BToTrkTrkMuMu_fit_pt': r'$p_T(B^{0})$',\n",
    "    'BToTrkTrkMuMu_fit_cos2D': r'$\\cos(\\alpha_{2D})$',\n",
    "    'BToTrkTrkMuMu_svprob': 'SV Fit Probability'\n",
    "}\n",
    "\n",
    "\n",
    "feature_names = list(labels_dict.keys())\n",
    "model_final.get_booster().feature_names = feature_names\n",
    "\n",
    "imp_type = 'weight' \n",
    "fig, ax = plt.subplots(figsize=(12, 9)) \n",
    "\n",
    "importance = model_final.get_booster().get_score(importance_type=imp_type)\n",
    "imp_df = pd.DataFrame.from_dict(importance, orient='index', columns=[imp_type])\n",
    "\n",
    "imp_df['PrettyLabel'] = [labels_dict.get(name, name) for name in imp_df.index]\n",
    "max_val = imp_df[imp_type].max()\n",
    "imp_df['Normalized'] = imp_df[imp_type] / max_val if max_val > 0 else 0\n",
    "imp_df = imp_df.sort_values('Normalized', ascending=True)\n",
    "\n",
    "bars = ax.barh(imp_df['PrettyLabel'], imp_df['Normalized'], color='lightsteelblue', edgecolor='black', height=0.7)\n",
    "for bar in bars:\n",
    "    width = bar.get_width()\n",
    "    ax.text(width + 0.02, bar.get_y() + bar.get_height()/2, f'{width:.3f}', va='center', color='black', \n",
    "            fontsize=14, fontweight='bold')\n",
    "\n",
    "ax.set_xlabel(\"Normalized Importance (Weight)\", fontsize=22)\n",
    "ax.set_xlim(0, 1.2) \n",
    "ax.tick_params(axis='both', labelsize=16)\n",
    "hep.cms.label(ax=ax, label=\"Work in Progress\", data=True, lumi=31.69, year=\"2022\", com=13.6, fontsize=19)\n",
