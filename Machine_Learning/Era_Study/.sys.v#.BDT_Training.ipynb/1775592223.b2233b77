    }
   ],
   "source": [
    "cv_roc  = StratifiedKFold(n_splits=10, shuffle=True, random_state=42)\n",
    "tprs    = []\n",
    "aucs_cv = []\n",
    "mean_fpr = np.linspace(0, 1, 100)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "\n",
    "for fold, (tr_idx, val_idx) in enumerate(cv_roc.split(X_train, y_train)):\n",
    "    X_f_tr, X_f_val = X_train[tr_idx], X_train[val_idx]\n",
    "    y_f_tr, y_f_val = y_train[tr_idx], y_train[val_idx]\n",
    "    w_f_tr          = w_train[tr_idx]\n",
    "\n",
    "    model_fold = xgb.XGBClassifier(\n",
    "        **best_params,\n",
    "        objective='binary:logistic',\n",
    "        tree_method='hist',\n",
    "        eval_metric='auc',\n",
    "        random_state=42,\n",
    "        n_jobs=-1,\n",
    "    )\n",
    "    model_fold.fit(X_f_tr, y_f_tr, sample_weight=w_f_tr, verbose=False)\n",
    "\n",
    "    y_prob_fold = model_fold.predict_proba(X_f_val)[:, 1]\n",
    "    fpr_f, tpr_f, _ = roc_curve(y_f_val, y_prob_fold)\n",
    "    auc_fold = auc(fpr_f, tpr_f)\n",
    "\n",
    "    ax.plot(fpr_f, tpr_f, lw=1, alpha=0.3,\n",
    "            label=f\"Fold {fold} (AUC = {auc_fold:.3f})\")\n",
    "\n",
    "    interp_tpr = np.interp(mean_fpr, fpr_f, tpr_f)\n",
    "    interp_tpr[0] = 0.0\n",
    "    tprs.append(interp_tpr)\n",
    "    aucs_cv.append(auc_fold)\n",
    "\n",
    "# Curva média\n",
    "mean_tpr      = np.mean(tprs, axis=0)\n",
    "mean_tpr[-1]  = 1.0\n",
    "#mean_auc      = auc(mean_fpr, mean_tpr)\n",
    "mean_auc = np.mean(aucs_cv)\n",
    "std_auc       = np.std(aucs_cv)\n",
    "std_tpr       = np.std(tprs, axis=0)\n",
    "\n",
    "ax.plot([0, 1], [0, 1], linestyle='--', lw=2, color='black', label='Acaso', alpha=0.8)\n",
    "ax.plot(mean_fpr, mean_tpr, color='blue', lw=2.5,\n",
    "        label=rf\"ROC Média (AUC = {mean_auc:.3f} $\\pm$ {std_auc:.3f})\")\n",
    "ax.fill_between(mean_fpr,\n",
    "                np.maximum(mean_tpr - std_tpr, 0),\n",
    "                np.minimum(mean_tpr + std_tpr, 1),\n",
    "                color='grey', alpha=0.2, label=r\"$\\pm$ 1 desvio padrão\")\n",
    "\n",
    "ax.set_xlim([0.0, 1.0])\n",
    "ax.set_ylim([0.0, 1.05])\n",
    "ax.set_xlabel(\"Eficiência de Background (FPR)\")\n",
    "ax.set_ylabel(\"Eficiência de Sinal (TPR)\")\n",
    "ax.legend(loc='lower right', fontsize=10, ncol=2)\n",
    "hep.cms.label(data=True, label=\"Work in Progress\", year=\"2022\",\n",
    "              lumi=31.69, loc=0, ax=ax, com=13.6)\n",
    "plt.tight_layout()\n",
    "os.makedirs(\"PlotsEE\", exist_ok=True)\n",
    "plt.savefig(\"PlotsEE/ROC_curve_cv.png\", dpi=150)\n",
    "plt.show()"
   ]
  },
