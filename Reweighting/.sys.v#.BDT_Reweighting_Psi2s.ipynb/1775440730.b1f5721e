   "source": [
    "df_data = build_dataframe(data_files, \"Data (Sidebands)\", mode=\"data\")\n",
    "df_mc   = build_dataframe(mc_files, \"MC Signal (Truth Matched)\", mode=\"mc\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "e5bde534-22fc-4ff0-b0eb-864592d39700",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Index(['BToTrkTrkMuMu_fit_l1_pt', 'BToTrkTrkMuMu_fit_l2_pt',\n",
       "       'BToTrkTrkMuMu_fit_trk1_pt', 'BToTrkTrkMuMu_fit_trk2_pt',\n",
       "       'BToTrkTrkMuMu_fit_eta', 'BToTrkTrkMuMu_fit_cos2D',\n",
       "       'BToTrkTrkMuMu_trk1_dca_sig', 'BToTrkTrkMuMu_trk2_dca_sig',\n",
       "       'BToTrkTrkMuMu_fit_mass_Kpi'],\n",
       "      dtype='object')"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df_data.keys()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "1295c035-4624-48a5-a92e-c66f40e6890c",
   "metadata": {},
   "outputs": [],
   "source": [
    "obs = zfit.Space(\"BToTrkTrkMuMu_fit_mass_Kpi\", limits=(5.0, 5.6))\n",
    "data_zfit = zfit.Data.from_pandas(df_data[\"BToTrkTrkMuMu_fit_mass_Kpi\"], obs=obs)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "1a3b0deb-05c9-4b7b-913a-dbeb065ac32d",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu    = zfit.Parameter(\"mu\", 5.28, 5.15, 5.40)\n",
    "sigma = zfit.Parameter(\"sigma\", 0.025, 0.005, 0.100)\n",
    "alphal = zfit.Parameter(\"alphal\", 1.5, 0.1, 5.0)\n",
    "nl     = zfit.Parameter(\"nl\", 5.0, 0.1, 30.0)\n",
    "alphar = zfit.Parameter(\"alphar\", 1.5, 0.1, 5.0)\n",
    "nr     = zfit.Parameter(\"nr\", 5.0, 0.1, 30.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "34be1d85-01c5-485b-b496-f45a47fa6171",
   "metadata": {},
   "outputs": [],
   "source": [
    "tau = zfit.Parameter(\"tau\", -2.0, -10.0, 0.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "f855d46d-33e5-466a-b988-70045e22c480",
   "metadata": {},
   "outputs": [],
   "source": [
    "total_ev = len(df_data)\n",
    "n_sig = zfit.Parameter(\"n_sig\", total_ev * 0.1, 0, total_ev)\n",
    "n_bkg = zfit.Parameter(\"n_bkg\", total_ev * 0.9, 0, total_ev)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "2b0b5769-8c99-4ed0-a8eb-32786fd6567d",
   "metadata": {},
   "outputs": [],
   "source": [
    "signal_pdf = zfit.pdf.DoubleCB(mu=mu, sigma=sigma, alphal=alphal, nl=nl, alphar=alphar, nr=nr, obs=obs)\n",
    "bkg_pdf    = zfit.pdf.Exponential(lambda_=tau, obs=obs)\n",
    "\n",
    "signal_ext = signal_pdf.create_extended(n_sig)\n",
    "bkg_ext    = bkg_pdf.create_extended(n_bkg)\n",
    "model = zfit.pdf.SumPDF([signal_ext, bkg_ext])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "d787dfb3-3102-4091-bf35-efe0a3e6a430",
   "metadata": {},
   "outputs": [],
   "source": [
    "nll = zfit.loss.ExtendedUnbinnedNLL(model, data_zfit)\n",
    "minimizer = zfit.minimize.Minuit(tol=1e-3)\n",
    "result = minimizer.minimize(nll)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "50474061-8abe-4a22-a1f5-f8a190eddc1e",
