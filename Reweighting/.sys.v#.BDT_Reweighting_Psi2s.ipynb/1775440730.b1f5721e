     ]
    }
   ],
   "source": [
    "print(f\"Aplicando os pesos no MC ({len(df_mc_clean)} eventos)...\")\n",
    "df_mc_clean[\"xgb_weight\"] = compute_weights(clf_carregado, df_mc_clean, FEATURES)\n",
    "\n",
    "print(\"\\nResumo dos pesos aplicados ao MC:\")\n",
    "print(df_mc_clean[\"xgb_weight\"].describe())"
   ]
