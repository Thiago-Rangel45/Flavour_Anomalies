   "outputs": [],
   "source": [
    "def compute_weights(clf, df, features):\n",
    "    proba  = clf.predict_proba(df[features])\n",
    "    p_data = proba[:, 1]\n",
    "    p_mc   = proba[:, 0]\n",
    "    return p_data / np.clip(p_mc, 1e-6, None)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "e10f68d2-27e8-44ef-88c0-c433747a8620",
   "metadata": {},
   "outputs": [],
   "source": [
    "def clean_df(df, features):\n",
    "    df_clean = df.copy()\n",
    "    df_clean[features] = df_clean[features].replace([np.inf, -np.inf], np.nan)\n",
    "    df_clean = df_clean.dropna(subset=features).reset_index(drop=True)\n",
    "    return df_clean\n",
    "\n",
    "df_data_clean = clean_df(df_data, FEATURES)\n",
    "df_mc_clean   = clean_df(df_mc, FEATURES)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "7973fb5d-986b-4eaf-a7f7-628b28a6f221",
