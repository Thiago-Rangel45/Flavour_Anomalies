   "source": [
    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "import mplhep as hep\n",
    "import numpy as np\n",
    "\n",
    "# Cria a pasta de output caso ela não exista\n",
    "os.makedirs(\"plots_output\", exist_ok=True)\n",
    "\n",
    "# Configuração de estilo\n",
    "plt.style.use(hep.style.CMS) \n",
    "\n",
    "# Dicionário atualizado com os nomes exatos das features do dataframe\n",
    "labels_dict = {\n",
    "    \"BToTrkTrkMuMu_fit_l1_pt\": r\"$p_T(\\mu_1)$ [GeV]\",\n",
    "    \"BToTrkTrkMuMu_fit_l2_pt\": r\"$p_T(\\mu_2)$ [GeV]\",\n",
    "    \"BToTrkTrkMuMu_fit_trk1_pt\": r\"$p_T(trk_1)$ [GeV]\",\n",
    "    \"BToTrkTrkMuMu_fit_trk2_pt\": r\"$p_T(trk_2)$ [GeV]\",\n",
    "    \"BToTrkTrkMuMu_fit_eta\": r\"$\\eta(B^0)$\",\n",
    "    \"BToTrkTrkMuMu_fit_cos2D\": r\"$\\cos\\alpha_{2D}$\",\n",
    "    \"BToTrkTrkMuMu_trk1_dca_sig\": r\"DCA sig $(trk_1)$\",\n",
    "    \"BToTrkTrkMuMu_trk2_dca_sig\": r\"DCA sig $(trk_2)$\",\n",
    "}\n",
    "\n",
    "def plot_all_branches(df_data, df_mc, features, labels_dict):\n",
    "    for var in features:\n",
    "        # Define o label formatado\n",
    "        display_label = labels_dict.get(var, var)\n",
    "        \n",
    "        min_v, max_v = np.percentile(df_data[var], [1, 99])\n",
    "        bins = np.linspace(min_v, max_v, 40)\n",
    "        \n",
    "        # --- Cálculo da largura do bin ---\n",
    "        bin_width = bins[1] - bins[0]\n",
    "        \n",
    "        fig, (ax, rax) = plt.subplots(2, 1, figsize=(10, 12), \n",
    "                                      gridspec_kw={'height_ratios': [3, 1], 'hspace': 0.05}, \n",
    "                                      sharex=True)\n",
    "        \n",
    "        # --- Cálculo dos Histogramas ---\n",
    "        h_dat, _ = np.histogram(df_data[var], bins=bins, weights=df_data['sweight_sig'])\n",
    "        h_dat_err = np.sqrt(np.histogram(df_data[var], bins=bins, weights=df_data['sweight_sig']**2)[0])\n",
    "        \n",
    "        h_raw_v, _ = np.histogram(df_mc[var], bins=bins)\n",
    "        h_raw_err = np.sqrt(h_raw_v)\n",
    "        \n",
    "        # Ajustado para usar 'xgb_weight'\n",
    "        h_cor, _ = np.histogram(df_mc[var], bins=bins, weights=df_mc['xgb_weight'])\n",
    "        h_cor_err = np.sqrt(np.histogram(df_mc[var], bins=bins, weights=df_mc['xgb_weight']**2)[0])\n",
    "\n",
    "        # Normalização\n",
    "        s_raw = h_dat.sum() / h_raw_v.sum() if h_raw_v.sum() > 0 else 1\n",
    "        s_cor = h_dat.sum() / h_cor.sum() if h_cor.sum() > 0 else 1\n",
    "        \n",
    "        # --- Plot Superior ---\n",
    "        # Adicionado marker e markersize para manter o padrão de pontos para os dados\n",
    "        hep.histplot(h_dat, bins=bins, yerr=h_dat_err, label='Dados (sPlot)', \n",
    "                     ax=ax, histtype='errorbar', color='black', marker='o', markersize=4)\n",
    "        hep.histplot(h_raw_v * s_raw, bins=bins, label='MC Original', \n",
    "                     ax=ax, color='red', linestyle='--')\n",
    "        hep.histplot(h_cor * s_cor, bins=bins, label='MC Corrigido (XGBoost)', \n",
    "                     ax=ax, color='blue', lw=2)\n",
    "        \n",
    "        ax.set_yscale('log')\n",
    "        \n",
    "        # --- Lógica do Eixo Y Dinâmico ---\n",
    "        if \"GeV\" in display_label:\n",
    "            y_label = f\"Events / {bin_width:.3f} GeV\"\n",
    "        else:\n",
    "            y_label = f\"Events / {bin_width:.3f}\"\n",
    "            \n",
    "        ax.set_ylabel(y_label, fontsize=16)\n",
    "        ax.legend(fontsize=14)\n",
    "        \n",
    "        # Ajuste a luminosidade se necessário para o seu dataset completo\n",
    "        hep.cms.label(\"Work in Progress\", data=True, lumi=5.01, com=13.6, loc=0, ax=ax)\n",
    "        \n",
    "        # --- Ratio Plot ---\n",
    "        with np.errstate(divide='ignore', invalid='ignore'):\n",
    "            r_raw = h_dat / (h_raw_v * s_raw)\n",
    "            # Faltou o np.abs() aqui:\n",
    "            e_raw = np.abs(r_raw) * np.sqrt((h_dat_err/h_dat)**2 + (h_raw_err/h_raw_v)**2)\n",
    "            \n",
    "            r_cor = h_dat / (h_cor * s_cor)\n",
    "            # E aqui:\n",
    "            e_cor = np.abs(r_cor) * np.sqrt((h_dat_err/h_dat)**2 + (h_cor_err/h_cor)**2)\n",
    "            \n",
    "            for e in [e_raw, e_cor]: e[~np.isfinite(e)] = 0\n",
    "\n",
    "        rax.axhline(1, color='gray', linestyle='--')\n",
    "        hep.histplot(r_raw, bins=bins, yerr=e_raw, ax=rax, color='red', \n",
    "                     histtype='errorbar', marker='o', markersize=3)\n",
    "        hep.histplot(r_cor, bins=bins, yerr=e_cor, ax=rax, color='blue', \n",
    "                     histtype='errorbar', marker='o', markersize=3)\n",
    "        \n",
    "        rax.set_ylim(0.5, 1.5)\n",
    "        rax.set_ylabel(\"Data / MC\", fontsize=16)\n",
    "        rax.set_xlabel(display_label, fontsize=16) \n",
    "        \n",
    "        ax.tick_params(axis='both', which='major', labelsize=14)\n",
    "        rax.tick_params(axis='both', which='major', labelsize=14)\n",
    "        \n",
    "        plt.tight_layout()\n",
    "        plt.savefig(f\"plots_output/Comp_{var}_zfit_jpsi.png\", bbox_inches='tight')\n",
    "        plt.show()\n",
    "        \n",
    "# Chamada da função utilizando os dataframes e features corretos\n",
    "plot_all_branches(df_data_clean, df_mc_clean, FEATURES, labels_dict)"
   ]
  },
  {
