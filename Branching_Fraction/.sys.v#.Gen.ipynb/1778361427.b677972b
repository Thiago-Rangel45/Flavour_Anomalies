     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "[ERROR] Server responded with an error: [3010] Stating path '/cms/store/user/tdeandra/BPH_NanoAOD_MC/BdtoKstar2Mu_KstartoKPi_TuneCP5_13p6TeV_pythia8-evtgen/BPH_Nano_MC_BdtoKstarMuMu_NoFilter_2022/260427_132612/0000/' is disallowed.\n",
      "\n"
     ]
    }
   ],
   "source": [
    "# Configurações de caminho\n",
    "redirector = \"root://xrootd2.hepgrid.uerj.br:1094/\"\n",
    "path_in_storage = \"/cms/store/user/tdeandra/BPH_NanoAOD_MC/BdtoKstar2Mu_KstartoKPi_TuneCP5_13p6TeV_pythia8-evtgen/BPH_Nano_MC_BdtoKstarMuMu_NoFilter_2022/260427_132612/0000/\"\n",
    "\n",
    "# Comando para listar arquivos via XRootD e filtrar apenas os .root\n",
    "command = f\"xrdfs {redirector} ls {path_in_storage} | grep .root\"\n",
    "file_list = [redirector + f.strip() for f in os.popen(command).readlines()]\n",
    "\n",
    "if not file_list:\n",
    "    print(\"Erro: Nenhum arquivo encontrado. Verifique o caminho ou o seu Proxy.\")\n",
    "else:\n",
    "    print(f\"Lendo {len(file_list)} arquivos e montando o grafo Lazy...\")\n",
    "    df = uproot.dask(\n",
    "        {f: \"Events\" for f in file_list},\n",
    "        library=\"ak\"\n",
    "    )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "63ce3da1-6526-4377-a36f-3cd309b8827f",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = apply_truth_match(df)\n",
    "df = apply_selection(df)\n",
    "df = calculate_q2(df)"
   ]
  }
 ],
