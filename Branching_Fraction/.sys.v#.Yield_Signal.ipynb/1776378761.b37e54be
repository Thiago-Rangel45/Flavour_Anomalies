   "source": [
    "import uproot\n",
    "import awkward as ak\n",
    "import numpy as np\n",
    "\n",
    "tree = uproot.open(\"/eos/user/t/tdeandra/skim_outputs/Merged_Eras/Merged_mc_signal_2022.root:Events\")\n",
    "data = tree.arrays([\"BPHGenPart_pdgId\", \"BPHGenPart_genPartIdxMother\", \"BPHGenPart_mass\"])\n",
    "\n",
    "pdg_id = data[\"BPHGenPart_pdgId\"]\n",
    "mom_idx = data[\"BPHGenPart_genPartIdxMother\"]\n",
    "mass = data[\"BPHGenPart_mass\"]"
   ]
