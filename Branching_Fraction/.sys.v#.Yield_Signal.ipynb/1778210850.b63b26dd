   "source": [
    "meus_modelos = {}\n",
    "\n",
    "for i in range(5):\n",
    "    nome_arquivo = f\"xgboost_fold_{i}.joblib\"\n",
    "    caminho_completo = os.path.join(\"/eos/user/t/tdeandra/SWAN_projects/BPH_Analysis/Machine_Learning/bdt_models_final\", nome_arquivo)    \n",
    "    meus_modelos[f\"modelo_{i}\"] = joblib.load(caminho_completo)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "78d6a9c7-b76c-448a-8c69-69326c735633",
   "metadata": {},
