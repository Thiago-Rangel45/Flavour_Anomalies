     ]
    }
   ],
   "source": [
    "def apply_selection(df):\n",
    "\n",
    "    kstar_pdg = 0.892\n",
    "    mask_kpi_window = abs(df['BToTrkTrkMuMu_fit_ditrack_mass_Kpi'] - kstar_pdg) <= 0.150\n",
    "    mask_pik_window = abs(df['BToTrkTrkMuMu_fit_ditrack_mass_piK'] - kstar_pdg) <= 0.150\n",
    "    is_kpi_closer = abs(df['BToTrkTrkMuMu_fit_ditrack_mass_Kpi'] - kstar_pdg) < \\\n",
    "                    abs(df['BToTrkTrkMuMu_fit_ditrack_mass_piK'] - kstar_pdg)\n",
    "    \n",
    "    mask = (\n",
    "        (mask_kpi_window | mask_pik_window) &         \n",
    "        (is_kpi_closer) &\n",
    "        (((df['BToTrkTrkMuMu_mll_fullfit'] > 2.9) & (df['BToTrkTrkMuMu_mll_fullfit'] < 3.3)) &\n",
    "        (df['BPH_1Muon_pt'] > 2.0) & \n",
    "        (df['BPH_2Muon_pt'] > 2.0) & \n",
    "        (abs(df['BPH_1Muon_eta']) < 2.4) & \n",
    "        (abs(df['BPH_2Muon_eta']) < 2.4) &\n",
    "        (df['BToTrkTrkMuMu_fit_trk1_pt'] > 1.5) &\n",
    "        (df['BToTrkTrkMuMu_fit_trk2_pt'] > 1.5) \n",
    "    )\n",
    "    \n",
    "    cols_to_keep = [\n",
    "        'BToTrkTrkMuMu_fit_mass_Kpi', \"BToTrkTrkMuMu_mll_fullfit\"\n",
    "    ]\n",
    "        \n",
    "    return df[cols_to_keep][mask]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6fe73706-eb2a-439e-b141-93e980c30d94",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_dataframe(file_dict, label=\"Dataset\"):\n",
    "    print(f\"\\nProcessando {label}...\")\n",
    "\n",
    "    df = uproot.dask(file_dict)\n",
    "    df = apply_selection(df)\n",
    "\n",
    "    with ProgressBar():\n",
    "        awkward_array = df.compute()\n",
    "        df_pandas = ak.to_dataframe(awkward_array).reset_index(drop=True)\n",
    "\n",
    "    initial_len = len(df_pandas)\n",
    "    df_pandas = df_pandas.replace([np.inf, -np.inf], np.nan)\n",
    "    df_pandas = df_pandas.dropna()\n",
    "    final_len  = len(df_pandas)\n",
    "    removed    = initial_len - final_len\n",
    "\n",
    "    if removed > 0:\n",
    "        print(f\"  [Limpeza] Removidos {removed} eventos com NaN ou Inf ({removed/initial_len:.2%})\")\n",
    "\n",
    "    print(f\"{label} finalizado. Linhas: {final_len}\")\n",
    "    return df_pandas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c5f05802-e797-44b2-8057-e075d1b2fe34",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_data = build_dataframe(data_files, \"Data\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0621edd4-ffa5-491f-a9a1-c8d27d87dd23",
   "metadata": {},
   "outputs": [],
   "source": [
    "obs = zfit.Space(\"BToTrkTrkMuMu_fit_mass_Kpi\", limits=(5.0, 5.6))\n",
    "data_zfit = zfit.Data.from_pandas(df_data[\"BToTrkTrkMuMu_fit_mass_Kpi\"], obs=obs)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "13f67641-51f2-4fa9-9646-c7b1d09714d5",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu    = zfit.Parameter(\"mu\", 5.28, 5.15, 5.40)\n",
    "sigma = zfit.Parameter(\"sigma\", 0.025, 0.005, 0.100)\n",
    "alphal = zfit.Parameter(\"alphal\", 1.5, 0.1, 5.0)\n",
    "nl     = zfit.Parameter(\"nl\", 5.0, 0.1, 100.0)\n",
    "alphar = zfit.Parameter(\"alphar\", 1.5, 0.1, 5.0)\n",
    "nr     = zfit.Parameter(\"nr\", 5.0, 0.1, 30.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "20b68da6-e30e-4aa4-a1b5-c7b11c795012",
   "metadata": {},
   "outputs": [],
   "source": [
    "tau = zfit.Parameter(\"tau\", -2.0, -10.0, 0.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a040379a-455b-438c-a9de-13fedf5670f1",
   "metadata": {},
   "outputs": [],
   "source": [
    "total_ev = len(df_data)\n",
    "n_sig = zfit.Parameter(\"n_sig\", total_ev * 0.1, 0, total_ev)\n",
    "n_bkg = zfit.Parameter(\"n_bkg\", total_ev * 0.9, 0, total_ev)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4af4d747-1ebe-467e-963f-acc630209fd7",
   "metadata": {},
   "outputs": [],
   "source": [
    "signal_pdf = zfit.pdf.DoubleCB(mu=mu, sigma=sigma, alphal=alphal, nl=nl, alphar=alphar, nr=nr, obs=obs)\n",
    "bkg_pdf    = zfit.pdf.Exponential(lambda_=tau, obs=obs)\n",
    "\n",
    "signal_ext = signal_pdf.create_extended(n_sig)\n",
    "bkg_ext    = bkg_pdf.create_extended(n_bkg)\n",
    "model = zfit.pdf.SumPDF([signal_ext, bkg_ext])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a44fb5d1-e536-49a9-9535-0534239c148c",
   "metadata": {},
   "outputs": [],
   "source": [
    "nll = zfit.loss.ExtendedUnbinnedNLL(model, data_zfit)\n",
    "minimizer = zfit.minimize.Minuit(tol=1e-3)\n",
    "result = minimizer.minimize(nll)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "159ecc90-f887-4c6f-a8e5-8d3169053cc2",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(result)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c1a69539-dc21-4e57-95e8-6c6ea54f62de",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(8, 6))\n",
    "counts, edges = np.histogram(df_data[\"BToTrkTrkMuMu_fit_mass_Kpi\"], bins=50, range=(5.0, 5.6))\n",
    "hep.histplot(counts, bins=edges, yerr=True, histtype='errorbar', color='black', label='Dados')\n",
    "\n",
    "x_plot = np.linspace(5.0, 5.6, 1000)\n",
    "bw = 0.012 \n",
    "plt.plot(x_plot, model.ext_pdf(x_plot).numpy() * bw, color='blue', lw=3, label='Fit Total')\n",
    "plt.plot(x_plot, signal_ext.ext_pdf(x_plot).numpy() * bw, color='red', ls='--', label='Sinal (Double CB)')\n",
    "plt.plot(x_plot, bkg_ext.ext_pdf(x_plot).numpy() * bw, color='green', ls=':', label='Fundo (Exp)')\n",
    "\n",
    "plt.xlabel(r\"$m(K \\pi \\mu \\mu)$ [GeV]\", fontsize = 15)\n",
    "plt.ylabel(f\"Events / {bw:.3f} GeV\", fontsize = 15)\n",
    "plt.xlim(5.0, 5.6)\n",
    "plt.legend(fontsize=15)\n",
    "plt.tick_params(axis='both', which='major', labelsize=16)\n",
    "plt.show()"
   ]
  },
  {
