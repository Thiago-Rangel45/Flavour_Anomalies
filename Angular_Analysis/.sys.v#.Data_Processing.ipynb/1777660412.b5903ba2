 "cells": [
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0d67a84c-3cec-4e45-9775-c3032d72266d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Lendo /eos/user/t/tdeandra/BPH_Gen_NoFilter.root...\n",
      "Aplicando Truth Matching...\n",
      "Extraindo cinemática das partículas...\n",
      "Salvando 1146856 eventos em Filtered_Gen_Kinematics.root...\n",
      "Python finalizado! Siga para o C++.\n"
     ]
    }
   ],
   "source": [
    "import uproot\n",
    "import awkward as ak\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "def apply_strict_truth_match(pdg, mother, **branches):\n",
    "    local_idx = ak.local_index(pdg)\n",
    "\n",
    "    # Matrizes de parentesco\n",
    "    safe_mom = ak.where(mother >= 0, mother, 0)\n",
    "    mom_pdg  = pdg[safe_mom]\n",
    "    mom_pdg  = ak.where(mother >= 0, mom_pdg, -999)\n",
    "\n",
    "    safe_grandmom = safe_mom[safe_mom]\n",
    "    grandmom_pdg  = pdg[safe_grandmom]\n",
    "    grandmom_pdg  = ak.where(safe_mom >= 0, grandmom_pdg, -999)\n",
    "\n",
    "    # ======================================================================\n",
    "    # 1. ATRIBUIÇÃO DO ANCESTRAL (B0)\n",
    "    # ======================================================================\n",
    "    B_ancestor_idx = ak.full_like(pdg, -1)\n",
    "\n",
    "    B_ancestor_idx = ak.where((pdg == 511), local_idx, B_ancestor_idx)\n",
    "    B_ancestor_idx = ak.where((pdg == 313) & (mom_pdg == 511), safe_mom, B_ancestor_idx)\n",
    "    B_ancestor_idx = ak.where((pdg == 22)  & (mom_pdg == 511), safe_mom, B_ancestor_idx)\n",
    "\n",
    "    # Condições exatas de topologia\n",
    "    is_K     = (pdg == 321)  & (mom_pdg == 313) & (grandmom_pdg == 511)\n",
    "    is_pi    = (pdg == -211) & (mom_pdg == 313) & (grandmom_pdg == 511)\n",
    "    is_mu_m  = (pdg == 13)   & (mom_pdg == 22)  & (grandmom_pdg == 511)\n",
    "    is_mu_p  = (pdg == -13)  & (mom_pdg == 22)  & (grandmom_pdg == 511)\n",
    "    #is_gamma = (pdg == 22)   & (mom_pdg == 511)\n",
    "\n",
    "    B_ancestor_idx = ak.where(is_K, safe_grandmom, B_ancestor_idx)\n",
    "    B_ancestor_idx = ak.where(is_pi, safe_grandmom, B_ancestor_idx)\n",
    "    B_ancestor_idx = ak.where(is_mu_m | is_mu_p, safe_grandmom, B_ancestor_idx)\n",
    "\n",
    "    # ======================================================================\n",
    "    # 2. VALIDAÇÃO POR CADEIA DE DECAIMENTO (E NÃO POR EVENTO)\n",
    "    # ======================================================================\n",
    "    # Extraímos as listas de \"quais B0s\" geraram cada peça chave\n",
    "    anc_kstar = B_ancestor_idx[(pdg == 313) & (mom_pdg == 511)]\n",
    "    anc_K     = B_ancestor_idx[is_K]\n",
    "    anc_pi    = B_ancestor_idx[is_pi]\n",
    "    anc_mu_m  = B_ancestor_idx[is_mu_m]\n",
    "    anc_mu_p  = B_ancestor_idx[is_mu_p]\n",
    "    #anc_gamma = B_ancestor_idx[is_gamma]\n",
    "\n",
    "    # Preparamos o array de ancestrais para broadcasting (cruzar dados)\n",
    "    p_anc = B_ancestor_idx[:, :, np.newaxis]\n",
    "\n",
    "    # Para cada partícula, verificamos se o SEU B0 ancestral aparece EXATAMENTE 1 vez\n",
    "    # nas listas de peças requeridas do mesmo evento.\n",
    "    has_1_kstar = ak.sum(p_anc == anc_kstar[:, np.newaxis, :], axis=-1) == 1\n",
    "    has_1_K     = ak.sum(p_anc == anc_K[:, np.newaxis, :],     axis=-1) == 1\n",
    "    has_1_pi    = ak.sum(p_anc == anc_pi[:, np.newaxis, :],    axis=-1) == 1\n",
    "    has_1_mu_m  = ak.sum(p_anc == anc_mu_m[:, np.newaxis, :],  axis=-1) == 1\n",
    "    has_1_mu_p  = ak.sum(p_anc == anc_mu_p[:, np.newaxis, :],  axis=-1) == 1\n",
    "\n",
    "    #has_2_gammas = ak.sum(p_anc == anc_gamma[:, np.newaxis, :], axis=-1) == 2\n",
    "    # Uma partícula pertence a um SINAL VÁLIDO apenas se o seu B0 gerou todas as peças\n",
    "    is_valid_chain = has_1_kstar & has_1_K & has_1_pi & has_1_mu_m & has_1_mu_p #& has_2_gammas\n",
    "\n",
    "    # Máscara final: A partícula faz parte de uma cadeia válida e tem um ancestral mapeado\n",
    "    particle_mask = is_valid_chain & (B_ancestor_idx >= 0)\n",
    "\n",
    "    # ======================================================================\n",
    "    # 3. FILTRAGEM FINAL\n",
    "    # ======================================================================\n",
    "    # Opcional: Se quiser descartar eventos que ficaram vazios após o filtro\n",
    "    event_has_signal = ak.sum(particle_mask, axis=1) > 0\n",
    "    \n",
    "    results = {'pdg': pdg[particle_mask][event_has_signal]}\n",
    "    for name, array in branches.items():\n",
    "        results[name] = array[particle_mask][event_has_signal]\n",
    "\n",
    "    return results\n",
    "\n",
    "# ==============================================================================\n",
    "# SCRIPT PRINCIPAL\n",
    "# ==============================================================================\n",
    "input_file = \"/eos/user/t/tdeandra/BPH_Gen_NoFilter.root\"\n",
    "output_file = \"Filtered_Gen_Kinematics_FSR.root\"\n",
    "\n",
    "print(f\"Lendo {input_file}...\")\n",
    "with uproot.open(input_file) as file:\n",
    "    tree = file[\"Events\"]\n",
    "    \n",
    "    raw_pdg    = tree[\"BPHGenPart_pdgId\"].array()\n",
    "    raw_mother = tree[\"BPHGenPart_genPartIdxMother\"].array()\n",
    "    raw_pt     = tree[\"BPHGenPart_pt\"].array()\n",
    "    raw_eta    = tree[\"BPHGenPart_eta\"].array()\n",
    "    raw_phi    = tree[\"BPHGenPart_phi\"].array()\n",
    "    raw_mass   = tree[\"BPHGenPart_mass\"].array()\n",
    "\n",
    "print(\"Aplicando Truth Matching...\")\n",
    "data = apply_strict_truth_match(\n",
    "    pdg=raw_pdg, mother=raw_mother, \n",
    "    pt=raw_pt, eta=raw_eta, phi=raw_phi, mass=raw_mass\n",
    ")\n",
    "\n",
    "pdg = data['pdg']\n",
    "\n",
    "def extract_kinematics(target_pdg):\n",
    "    mask = pdg == target_pdg\n",
    "    return {\n",
    "        \"pt\": ak.to_numpy(ak.firsts(data[\"pt\"][mask])),\n",
    "        \"eta\": ak.to_numpy(ak.firsts(data[\"eta\"][mask])),\n",
    "        \"phi\": ak.to_numpy(ak.firsts(data[\"phi\"][mask])),\n",
    "        \"mass\": ak.to_numpy(ak.firsts(data[\"mass\"][mask]))\n",
    "    }\n",
    "\n",
    "print(\"Extraindo cinemática das partículas...\")\n",
    "particles = {\n",
    "    \"B0\": 511, \"Kst\": 313, \"mu1\": -13, \"mu2\": 13, \"K\": 321, \"pi\": -211\n",
    "}\n",
    "\n",
    "output_dict = {}\n",
    "for name, pdg_code in particles.items():\n",
    "    kin = extract_kinematics(pdg_code)\n",
    "    output_dict[f\"{name}_pt\"] = kin[\"pt\"]\n",
    "    output_dict[f\"{name}_eta\"] = kin[\"eta\"]\n",
    "    output_dict[f\"{name}_phi\"] = kin[\"phi\"]\n",
    "    output_dict[f\"{name}_mass\"] = kin[\"mass\"]\n",
    "\n",
    "print(f\"Salvando {len(output_dict['B0_pt'])} eventos em {output_file}...\")\n",
    "with uproot.recreate(output_file) as out_f:\n",
    "    out_f[\"Events\"] = output_dict\n",
    "\n",
    "print(\"Python finalizado! Siga para o C++.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9a10a036-bc12-4632-80cc-a122d1d23ee3",
