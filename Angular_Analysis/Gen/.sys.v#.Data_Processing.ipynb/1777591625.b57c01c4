   "source": [
    "# ==============================================================================\n",
    "# CÉLULA DE INSPEÇÃO DE EVENTOS (CORRIGIDA)\n",
    "# ==============================================================================\n",
    "import awkward as ak\n",
    "\n",
    "# Verificamos se 'data' é o dicionário esperado. \n",
    "# Se você rodou a célula anterior, 'data' deve conter as chaves filtradas.\n",
    "try:\n",
    "    total_original = len(raw_pdg)\n",
    "    # Usamos o acesso ao dicionário 'data'\n",
    "    pdgs_filtrados = data['pdg']\n",
    "    massas_filtradas = data['mass']\n",
    "    \n",
    "    total_retido = len(pdgs_filtrados)\n",
    "\n",
    "    print(f\"Total original: {total_original}\")\n",
    "    print(f\"Total de eventos de SINAL retidos: {total_retido}\")\n",
    "    print(\"-\" * 30)\n",
    "\n",
    "    # Loop para mostrar os primeiros 5 eventos\n",
    "    for i in range(min(10, total_retido)):\n",
    "        # Convertemos o awkward array do evento i para lista Python\n",
    "        event_pdgs = ak.to_list(pdgs_filtrados[i])\n",
    "        event_mass = ak.to_list(massas_filtradas[i])\n",
    "        \n",
    "        print(f\"Evento {i}:\")\n",
    "        print(f\"  PDG  : {event_pdgs}\")\n",
    "        # Round para limpar a visualização das massas\n",
    "        print(f\"  Mass : {[round(m, 5) if m > 0 else 0.0 for m in event_mass]}\")\n",
    "        print(\"\")\n",
    "\n",
    "except TypeError as e:\n",
    "    print(f\"Erro de tipo: {e}\")\n",
    "    print(\"Dica: Verifique se a variável 'data' não foi modificada após a função apply_strict_truth_match.\")\n",
    "except KeyError as e:\n",
    "    print(f\"Erro de chave: A chave {e} não existe no dicionário 'data'.\")"
   ]
  },
