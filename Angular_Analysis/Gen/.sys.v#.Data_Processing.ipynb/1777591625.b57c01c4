   "source": [
    "n_b0_per_event = ak.num(pdg[pdg == 511], axis=1) + ak.num(pdg[pdg == -511], axis=1)\n",
    "\n",
    "multi_signal_mask    = n_b0_per_event > 1\n",
    "indices_multi_signal = np.where(ak.to_numpy(multi_signal_mask))[0]\n",
    "total_multi          = int(ak.sum(multi_signal_mask))\n",
    "\n",
    "print(f\"\\nTotal de eventos com sinal: {len(pdg)}\")\n",
    "print(f\"Eventos com MAIS DE UM B0/B0bar: {total_multi}\")\n",
    "\n",
    "if total_multi > 0:\n",
    "    print(\"\\nExemplo dos primeiros eventos com multi-sinal:\")\n",
    "    print(\"-\" * 50)\n",
    "    pdg_multi   = pdg[multi_signal_mask]\n",
    "    B_idx_multi = B_idx[multi_signal_mask]\n",
    "\n",
    "    for i in range(min(3, total_multi)):\n",
    "        idx_original = indices_multi_signal[i]\n",
    "        n_b0s        = int(n_b0_per_event[idx_original])\n",
    "        # Quais B_idx únicos existem nesse evento\n",
    "        b_indices    = np.unique(ak.to_numpy(B_idx_multi[i]))\n",
    "        # Quantos são B0 vs B0bar\n",
    "        pdg_ev       = ak.to_numpy(pdg_multi[i])\n",
    "        b_idx_ev     = ak.to_numpy(B_idx_multi[i])\n",
    "        n_B0    = int(np.sum(pdg_ev == 511))\n",
    "        n_B0bar = int(np.sum(pdg_ev == -511))\n",
    "\n",
    "        print(f\"Evento no índice {idx_original}:\")\n",
    "        print(f\"  B0s encontrados : {n_B0}\")\n",
    "        print(f\"  B0bars encontrados: {n_B0bar}\")\n",
    "        print(f\"  B_idx únicos: {b_indices.tolist()}\")\n",
    "        print(f\"  PDGs completos: {pdg_ev.tolist()}\\n\")\n",
    "else:\n",
    "    print(\"\\nNão foram encontrados eventos com mais de um sinal simultâneo.\")"
   ]
  },
