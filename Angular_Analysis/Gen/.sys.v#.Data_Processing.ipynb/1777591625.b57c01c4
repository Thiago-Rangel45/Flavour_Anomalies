   "source": [
    "import uproot\n",
    "import awkward as ak\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "def apply_strict_truth_match(pdg, mother, **branches):\n",
    "    local_idx = ak.local_index(pdg)\n",
    "\n",
    "    safe_mom     = ak.where(mother >= 0, mother, 0)\n",
    "    mom_pdg      = pdg[safe_mom]\n",
    "    mom_pdg      = ak.where(mother >= 0, mom_pdg, -999)\n",
    "\n",
    "    safe_grandmom = safe_mom[safe_mom]\n",
    "    grandmom_pdg  = pdg[safe_grandmom]\n",
    "    grandmom_pdg  = ak.where(safe_mom >= 0, grandmom_pdg, -999)\n",
    "\n",
    "    is_B0    = (pdg ==  511)\n",
    "    is_B0bar = (pdg == -511)\n",
    "    is_B_any = is_B0 | is_B0bar\n",
    "\n",
    "    B_ancestor_idx = ak.full_like(pdg, -1)\n",
    "    B_ancestor_idx = ak.where(is_B_any, local_idx, B_ancestor_idx)\n",
    "\n",
    "    is_Kst_child = ((pdg == 313) | (pdg == -313)) & (is_B_any[safe_mom])\n",
    "    is_gam_child = (pdg == 22) & (is_B_any[safe_mom])\n",
    "\n",
    "    B_ancestor_idx = ak.where(is_Kst_child, safe_mom, B_ancestor_idx)\n",
    "    B_ancestor_idx = ak.where(is_gam_child, safe_mom, B_ancestor_idx)\n",
    "\n",
    "    is_K_B0       = (pdg ==  321) & ((mom_pdg ==  313) | (mom_pdg == -313)) & (grandmom_pdg ==  511)\n",
    "    is_pi_B0      = (pdg == -211) & ((mom_pdg ==  313) | (mom_pdg == -313)) & (grandmom_pdg ==  511)\n",
    "    is_mu_m_B0    = (pdg ==  13)  & (mom_pdg ==  22)  & (grandmom_pdg ==  511)\n",
    "    is_mu_p_B0    = (pdg == -13)  & (mom_pdg ==  22)  & (grandmom_pdg ==  511)\n",
    "\n",
    "    is_K_B0bar    = (pdg == -321) & ((mom_pdg ==  313) | (mom_pdg == -313)) & (grandmom_pdg == -511)\n",
    "    is_pi_B0bar   = (pdg ==  211) & ((mom_pdg ==  313) | (mom_pdg == -313)) & (grandmom_pdg == -511)\n",
    "    is_mu_m_B0bar = (pdg ==  13)  & (mom_pdg ==  22)  & (grandmom_pdg == -511)\n",
    "    is_mu_p_B0bar = (pdg == -13)  & (mom_pdg ==  22)  & (grandmom_pdg == -511)\n",
    "\n",
    "    is_K    = is_K_B0    | is_K_B0bar\n",
    "    is_pi   = is_pi_B0   | is_pi_B0bar\n",
    "    is_mu_m = is_mu_m_B0 | is_mu_m_B0bar\n",
    "    is_mu_p = is_mu_p_B0 | is_mu_p_B0bar\n",
    "    is_gamma = (pdg == 22) & (is_B_any[safe_mom])\n",
    "\n",
    "    B_ancestor_idx = ak.where(is_K,               safe_grandmom, B_ancestor_idx)\n",
    "    B_ancestor_idx = ak.where(is_pi,              safe_grandmom, B_ancestor_idx)\n",
    "    B_ancestor_idx = ak.where(is_mu_m | is_mu_p,  safe_grandmom, B_ancestor_idx)\n",
    "\n",
    "    anc_kstar = B_ancestor_idx[is_Kst_child]\n",
    "    anc_K     = B_ancestor_idx[is_K]\n",
    "    anc_pi    = B_ancestor_idx[is_pi]\n",
    "    anc_mu_m  = B_ancestor_idx[is_mu_m]\n",
    "    anc_mu_p  = B_ancestor_idx[is_mu_p]\n",
    "    anc_gamma = B_ancestor_idx[is_gamma]\n",
    "\n",
    "    p_anc = B_ancestor_idx[:, :, np.newaxis]\n",
    "\n",
    "    has_1_kstar  = ak.sum(p_anc == anc_kstar[:, np.newaxis, :], axis=-1) == 1\n",
    "    has_1_K      = ak.sum(p_anc == anc_K[:, np.newaxis, :],     axis=-1) == 1\n",
    "    has_1_pi     = ak.sum(p_anc == anc_pi[:, np.newaxis, :],    axis=-1) == 1\n",
    "    has_1_mu_m   = ak.sum(p_anc == anc_mu_m[:, np.newaxis, :],  axis=-1) == 1\n",
    "    has_1_mu_p   = ak.sum(p_anc == anc_mu_p[:, np.newaxis, :],  axis=-1) == 1\n",
    "    has_2_gammas = ak.sum(p_anc == anc_gamma[:, np.newaxis, :], axis=-1) == 2\n",
    "\n",
    "    is_valid_chain   = has_1_kstar & has_1_K & has_1_pi & has_1_mu_m & has_1_mu_p & has_2_gammas\n",
    "    particle_mask    = is_valid_chain & (B_ancestor_idx >= 0)\n",
    "    event_has_signal = ak.sum(particle_mask, axis=1) > 0\n",
    "\n",
    "    pdg_sig   = pdg[event_has_signal]\n",
    "    mask_sig  = particle_mask[event_has_signal]\n",
    "    B_anc_sig = B_ancestor_idx[event_has_signal]\n",
    "\n",
    "    B_pdg_sig = pdg_sig[B_anc_sig]\n",
    "    is_Bbar   = (B_pdg_sig == -511) & mask_sig\n",
    "\n",
    "    # event_idx como jagged do mesmo shape que pdg_sig — CORREÇÃO PRINCIPAL\n",
    "    event_global_idx  = ak.local_index(pdg_sig, axis=0)\n",
    "    event_idx_jagged  = ak.broadcast_arrays(event_global_idx[:, np.newaxis], pdg_sig)[0]\n",
    "\n",
    "    results = {\n",
    "        'pdg':       pdg_sig[mask_sig],\n",
    "        'B_idx':     B_anc_sig[mask_sig],\n",
    "        'is_Bbar':   is_Bbar[mask_sig],\n",
    "        'event_idx': event_idx_jagged[mask_sig],   # shape correto agora\n",
    "    }\n",
    "    for name, array in branches.items():\n",
    "        results[name] = array[event_has_signal][mask_sig]\n",
    "\n",
    "    return results\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# SCRIPT PRINCIPAL\n",
    "# ==============================================================================\n",
    "input_file  = \"/eos/user/t/tdeandra/BPH_Gen_NoFilter.root\"\n",
    "output_file = \"Filtered_Gen_Kinematics.root\"\n",
    "\n",
    "print(f\"Lendo {input_file}...\")\n",
    "with uproot.open(input_file) as file:\n",
    "    tree = file[\"Events\"]\n",
    "\n",
    "    raw_pdg    = tree[\"BPHGenPart_pdgId\"].array()\n",
    "    raw_mother = tree[\"BPHGenPart_genPartIdxMother\"].array()\n",
    "    raw_pt     = tree[\"BPHGenPart_pt\"].array()\n",
    "    raw_eta    = tree[\"BPHGenPart_eta\"].array()\n",
    "    raw_phi    = tree[\"BPHGenPart_phi\"].array()\n",
    "    raw_mass   = tree[\"BPHGenPart_mass\"].array()\n",
    "\n",
    "print(\"Aplicando Truth Matching...\")\n",
    "data = apply_strict_truth_match(\n",
    "    pdg=raw_pdg, mother=raw_mother,\n",
    "    pt=raw_pt, eta=raw_eta, phi=raw_phi, mass=raw_mass\n",
    ")\n",
    "\n",
    "pdg     = data['pdg']\n",
    "B_idx   = data['B_idx']\n",
    "ev_idx  = data['event_idx']\n",
    "is_Bbar = data['is_Bbar']\n",
    "\n",
    "particles = {\n",
    "    \"B0\":  ( 511, -511),\n",
    "    \"Kst\": ( 313, -313),\n",
    "    \"mu1\": ( -13,  -13),\n",
    "    \"mu2\": (  13,   13),\n",
    "    \"K\":   ( 321, -321),\n",
    "    \"pi\":  (-211,  211),\n",
    "}\n",
    "\n",
    "def extract_kinematics_all(pdg_B0, pdg_B0bar):\n",
    "    mask = (pdg == pdg_B0) | (pdg == pdg_B0bar)\n",
    "    return {\n",
    "        \"pt\":        ak.to_numpy(ak.flatten(data[\"pt\"][mask])),\n",
    "        \"eta\":       ak.to_numpy(ak.flatten(data[\"eta\"][mask])),\n",
    "        \"phi\":       ak.to_numpy(ak.flatten(data[\"phi\"][mask])),\n",
    "        \"mass\":      ak.to_numpy(ak.flatten(data[\"mass\"][mask])),\n",
    "        \"B_idx\":     ak.to_numpy(ak.flatten(B_idx[mask])),\n",
    "        \"event_idx\": ak.to_numpy(ak.flatten(ev_idx[mask])),\n",
    "        \"is_Bbar\":   ak.to_numpy(ak.flatten(is_Bbar[mask])),\n",
    "    }\n",
    "\n",
    "print(\"Extraindo cinemática de todos os candidatos (B0 + B0bar)...\")\n",
    "output_dict = {}\n",
    "n_candidates = None\n",
    "\n",
    "for name, (pdg_B0, pdg_B0bar) in particles.items():\n",
    "    kin = extract_kinematics_all(pdg_B0, pdg_B0bar)\n",
    "    output_dict[f\"{name}_pt\"]        = kin[\"pt\"]\n",
    "    output_dict[f\"{name}_eta\"]       = kin[\"eta\"]\n",
    "    output_dict[f\"{name}_phi\"]       = kin[\"phi\"]\n",
    "    output_dict[f\"{name}_mass\"]      = kin[\"mass\"]\n",
    "    output_dict[f\"{name}_B_idx\"]     = kin[\"B_idx\"]\n",
    "    output_dict[f\"{name}_event_idx\"] = kin[\"event_idx\"]\n",
    "    output_dict[f\"{name}_is_Bbar\"]   = kin[\"is_Bbar\"]\n",
    "\n",
    "    if n_candidates is None:\n",
    "        n_candidates = len(kin[\"pt\"])\n",
    "\n",
    "print(f\"Salvando {n_candidates} candidatos em {output_file}...\")\n",
    "with uproot.recreate(output_file) as out_f:\n",
    "    out_f[\"Events\"] = output_dict\n",
    "\n",
    "print(\"Concluído!\")"
   ]
  },
