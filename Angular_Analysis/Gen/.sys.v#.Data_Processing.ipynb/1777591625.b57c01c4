   "source": [
    "import ROOT\n",
    "\n",
    "# 1. Abrir o arquivo e capturar o Workspace/Dataset\n",
    "f = ROOT.TFile.Open(\"effDataset_GENOnly_b0.root\")\n",
    "ws = f.Get(\"ws_b0p0\")\n",
    "data = ws.data(\"data_genDen_ev_b0\")\n",
    "\n",
    "# 2. Obter as variáveis do Workspace\n",
    "ctK = ws.var(\"ctK\")\n",
    "ctL = ws.var(\"ctL\")\n",
    "phi = ws.var(\"phi\")\n",
    "\n",
    "# 3. Criar o Canvas e dividir em 3 partes\n",
    "c = ROOT.TCanvas(\"c1\", \"Bin 0 - Angular Variables\", 1200, 400)\n",
    "c.Divide(3, 1)\n",
    "\n",
    "# --- Plot Cos(Theta_K) ---\n",
    "c.cd(1)\n",
    "frame_k = ctK.frame(ROOT.RooFit.Title(\"cos(#theta_{K})\"))\n",
    "data.plotOn(frame_k, ROOT.RooFit.MarkerStyle(20), ROOT.RooFit.MarkerSize(0.8))\n",
    "frame_k.Draw()\n",
    "\n",
    "# --- Plot Cos(Theta_L) ---\n",
    "c.cd(2)\n",
    "frame_l = ctL.frame(ROOT.RooFit.Title(\"cos(#theta_{L})\"))\n",
    "data.plotOn(frame_l, ROOT.RooFit.MarkerStyle(20), ROOT.RooFit.MarkerSize(0.8), ROOT.RooFit.MarkerColor(ROOT.kRed))\n",
    "frame_l.Draw()\n",
    "\n",
    "# --- Plot Phi ---\n",
    "c.cd(3)\n",
    "frame_phi = phi.frame(ROOT.RooFit.Title(\"#phi (rad)\"))\n",
    "data.plotOn(frame_phi, ROOT.RooFit.MarkerStyle(20), ROOT.RooFit.MarkerSize(0.8), ROOT.RooFit.MarkerColor(ROOT.kBlue))\n",
    "frame_phi.Draw()\n",
    "\n",
    "# 4. Renderizar o Canvas no Jupyter\n",
    "c.Draw()\n",
    "c.SaveAs(\"teste.png\")"
   ]
  },
