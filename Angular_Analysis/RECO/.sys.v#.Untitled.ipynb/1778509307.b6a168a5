    "\n",
    "file = uproot.open(\"/eos/user/t/tdeandra/skim_outputs/BPH_Gen_NoFilter.root\")\n",
    "tree = file[\"Events\"]\n",
    "\n",
    "for branche in tree.keys():\n",
    "    if \"genPartIdx\" in branche:\n",
    "        print(branche)"
   ]
