{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "860c7749-2d18-4982-bf69-a8650bf727f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "import uproot\n",
    "import dask_awkward as dak\n",
    "import awkward as ak\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import mplhep as hep\n",
    "from dask.diagnostics import ProgressBar"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ad08199d-0a1f-4ffe-9c85-a22744116672",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.style.use(hep.style.CMS)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "d0b1459c-56a9-4433-9a38-debba24de761",
   "metadata": {},
   "outputs": [],
   "source": [
    "mc_files = \"/eos/user/t/tdeandra/skim_outputs/Merged_Eras/Merged_mc_jpsi_2022.root\"\n",
    "file = uproot.open(mc_files)\n",
    "tree = file[\"Events\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "f5ebeabb-c666-44c1-b95e-212f25f73f22",
   "metadata": {},
   "outputs": [],
   "source": [
    "PDG_B0        =  511\n",
    "PDG_KSTAR     =  313\n",
    "PDG_KAON_plus =  321\n",
    "PDG_PION_neg  = -211\n",
    "PDG_PHOTON    =  22\n",
    "PDG_JPSI      =  443\n",
    "PDG_MUON_plus = -13\n",
    "PDG_MUON_neg  =  13"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "b9c0dab2-2a37-478d-be2e-d775975063bd",
   "metadata": {},
   "outputs": [],
   "source": [
    "pdg_ids = tree[\"BPHGenPart_pdgId\"].array()\n",
    "mom_idx = tree[\"BPHGenPart_genPartIdxMother\"].array()\n",
    "\n",
    "mu1_idx  = tree[\"BPH_1Muon_genPartIdx\"].array()\n",
    "mu2_idx  = tree[\"BPH_2Muon_genPartIdx\"].array()\n",
    "trk1_idx = tree[\"Trk1_genPartIdx\"].array()\n",
    "trk2_idx = tree[\"Trk2_genPartIdx\"].array()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "e07ebc78-d91b-40e6-9ae3-4ba2c74b8154",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu1_pdg  = pdg_ids[ak.mask(mu1_idx, mu1_idx >= 0)]\n",
    "mu2_pdg  = pdg_ids[ak.mask(mu2_idx, mu2_idx >= 0)]\n",
    "trk1_pdg = pdg_ids[ak.mask(trk1_idx, trk1_idx >= 0)]\n",
    "trk2_pdg = pdg_ids[ak.mask(trk2_idx, trk2_idx >= 0)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "57180f03-2058-4edb-a7c9-30d6d6d56813",
   "metadata": {},
   "outputs": [],
   "source": [
    "flavor_match = (trk1_pdg == PDG_KAON_plus) & (trk2_pdg == PDG_PION_neg) & \\\n",
    "               (mu1_pdg == PDG_MUON_plus) & (mu2_pdg == PDG_MUON_neg)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "6f53de3a-3a40-4303-b58e-86bf0d5e28c7",
   "metadata": {},
   "outputs": [],
   "source": [
    "mom_trk1_idx = mom_idx[ak.mask(trk1_idx, trk1_idx >= 0)]\n",
    "mom_trk2_idx = mom_idx[ak.mask(trk2_idx, trk2_idx >= 0)]\n",
    "\n",
    "mom_trk1_pdg = pdg_ids[ak.mask(mom_trk1_idx, mom_trk1_idx >= 0)]\n",
    "mom_trk2_pdg = pdg_ids[ak.mask(mom_trk2_idx, mom_trk2_idx >= 0)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "631c6b9c-0bef-4032-9873-0c988211c53d",
   "metadata": {},
   "outputs": [],
   "source": [
    "match_kstar = (mom_trk1_idx == mom_trk2_idx) & (mom_trk1_idx >= 0) & (mom_trk2_idx >= 0) & \\\n",
    "              (mom_trk1_pdg == PDG_KSTAR) & (mom_trk2_pdg == PDG_KSTAR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "9c2929ca-d260-4c3d-a790-0c7a410d742f",
   "metadata": {},
   "outputs": [],
   "source": [
    "gmom_trk1_idx = mom_idx[ak.mask(mom_trk1_idx, mom_trk1_idx >= 0)]\n",
    "gmom_trk2_idx = mom_idx[ak.mask(mom_trk2_idx, mom_trk2_idx >= 0)]\n",
    "\n",
    "gmom_trk1_pdg = pdg_ids[ak.mask(gmom_trk1_idx, gmom_trk1_idx >= 0)]\n",
    "gmom_trk2_pdg = pdg_ids[ak.mask(gmom_trk2_idx, gmom_trk2_idx >= 0)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "d5f0f893-6137-4060-ad47-eef4e9d8a45e",
   "metadata": {},
   "outputs": [],
   "source": [
    "match_kstar_to_b0 = (gmom_trk1_idx == gmom_trk2_idx) & (gmom_trk1_idx >= 0) & (gmom_trk2_idx >= 0) & \\\n",
    "                    (gmom_trk1_pdg == PDG_B0) & (gmom_trk2_pdg == PDG_B0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "cf3b5b8e-7da1-4ea6-9d61-ba163090c8fc",
   "metadata": {},
   "outputs": [],
   "source": [
    "mom_mu1_idx = mom_idx[ak.mask(mu1_idx, mu1_idx >= 0)]\n",
    "mom_mu2_idx = mom_idx[ak.mask(mu2_idx, mu2_idx >= 0)]\n",
    "\n",
    "gmom_mu1_idx = mom_idx[ak.mask(mom_mu1_idx, mom_mu1_idx >= 0)]\n",
    "gmom_mu2_idx = mom_idx[ak.mask(mom_mu2_idx, mom_mu2_idx >= 0)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "59aedd5e-e6e0-4b95-821c-f3cf560453d4",
   "metadata": {},
   "outputs": [],
   "source": [
    "mom_mu1_pdg = pdg_ids[ak.mask(mom_mu1_idx, mom_mu1_idx >= 0)]\n",
    "mom_mu2_pdg = pdg_ids[ak.mask(mom_mu2_idx, mom_mu2_idx >= 0)]\n",
    "\n",
    "gmom_mu1_pdg = pdg_ids[ak.mask(gmom_mu1_idx, gmom_mu1_idx >= 0)]\n",
    "gmom_mu2_pdg = pdg_ids[ak.mask(gmom_mu2_idx, gmom_mu2_idx >= 0)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "1ba9ff01-4846-4b71-a13a-06157664e0fa",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PDG ID Mãe Muon | Frequência\n",
      "------------------------------\n",
      "22              | 592765    \n"
     ]
    }
   ],
   "source": [
    "flat_mom_mu1 = ak.to_numpy(ak.fill_none(ak.flatten(mom_mu1_pdg, axis=None), 0))\n",
    "values, counts = np.unique(flat_mom_mu1, return_counts=True)\n",
    "\n",
    "print(f\"{'PDG ID Mãe Muon':<15} | {'Frequência':<10}\")\n",
    "print(\"-\" * 30)\n",
    "for val, count in zip(values, counts):\n",
    "    label = \"None\" if val == 0 else val\n",
    "    print(f\"{label:<15} | {count:<10}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "beb63c56-d5f0-4170-a414-7c57b7cc884e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PDG ID Avó Muon | Frequência\n",
      "------------------------------\n",
      "-531            | 4         \n",
      "-13             | 6         \n",
      "411             | 4         \n",
      "421             | 7         \n",
      "443             | 592662    \n",
      "511             | 9         \n",
      "521             | 69        \n",
      "531             | 1         \n",
      "100443          | 3         \n"
     ]
    }
   ],
   "source": [
    "flat_gmom_mu1 = ak.to_numpy(ak.fill_none(ak.flatten(gmom_mu1_pdg, axis=None), 0))\n",
    "values, counts = np.unique(flat_gmom_mu1, return_counts=True)\n",
    "\n",
    "print(f\"{'PDG ID Avó Muon':<15} | {'Frequência':<10}\")\n",
    "print(\"-\" * 30)\n",
    "for val, count in zip(values, counts):\n",
    "    label = \"None\" if val == 0 else val\n",
    "    print(f\"{label:<15} | {count:<10}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8f2e2fc3-24c6-4404-af1f-b4ca6d55d29b",
