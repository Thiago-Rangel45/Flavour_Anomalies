   "cell_type": "markdown",
   "id": "9d356bc8-a7b3-4272-bb1e-f7e20345d92e",
   "metadata": {},
   "source": [
    "# Estudo de Truth Matching no canal NÃO RESSONANTE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "1f6f049f-5649-4343-a8eb-e357ac0829c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import uproot\n",
    "import dask_awkward as dak\n",
    "import awkward as ak\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import mplhep as hep\n",
    "from dask.diagnostics import ProgressBar"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ea387128-6297-44d5-826c-3d9514d0091f",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.style.use(hep.style.CMS)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "50bc0051-5164-48c9-94e1-eb0a29ff8bf7",
   "metadata": {},
   "outputs": [],
   "source": [
    "mc_files = \"/eos/user/t/tdeandra/skim_outputs/Merged_Eras/Merged_mc_signal_2022.root\"\n",
    "file = uproot.open(mc_files)\n",
    "tree = file[\"Events\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "e9740a11-29d5-4643-8e1e-19e72fc7adb6",
   "metadata": {},
   "outputs": [],
   "source": [
    "PDG_B0        = 511\n",
    "PDG_KSTAR     = 313\n",
    "PDG_KAON_plus = 321\n",
    "PDG_PION_neg  = -211\n",
    "PDG_MUON_plus = -13\n",
    "PDG_MUON_neg  = 13\n",
    "PDG_PHOTON    = 22"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "d6e346c4-db15-4ba1-976e-3274c5a57117",
   "metadata": {},
   "outputs": [],
   "source": [
    "pdg_ids = tree[\"BPHGenPart_pdgId\"].array()\n",
    "mom_idx = tree[\"BPHGenPart_genPartIdxMother\"].array()\n",
    "\n",
    "mu1_idx  = tree[\"BPH_1Muon_genPartIdx\"].array()\n",
    "mu2_idx  = tree[\"BPH_2Muon_genPartIdx\"].array()\n",
    "trk1_idx = tree[\"Trk1_genPartIdx\"].array()\n",
    "trk2_idx = tree[\"Trk2_genPartIdx\"].array()\n",
    "\n",
    "kaon_pt = tree[\"BToTrkTrkMuMu_fit_trk1_pt\"].array()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "7865a7a3-1969-4057-8b2c-9b60850bb884",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu1_pdg  = pdg_ids[ak.mask(mu1_idx, mu1_idx >= 0)]\n",
    "mu2_pdg  = pdg_ids[ak.mask(mu2_idx, mu2_idx >= 0)]\n",
    "trk1_pdg = pdg_ids[ak.mask(trk1_idx, trk1_idx >= 0)]\n",
    "trk2_pdg = pdg_ids[ak.mask(trk2_idx, trk2_idx >= 0)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "33b66949-b986-41b7-95bb-8ebf2595e2f4",
   "metadata": {},
   "outputs": [],
   "source": [
    "flavor_match = (trk1_pdg == PDG_KAON_plus) & (trk2_pdg == PDG_PION_neg) & \\\n",
    "               (mu1_pdg == PDG_MUON_plus) & (mu2_pdg == PDG_MUON_neg)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "1431d9d1-42be-42b9-a46f-80379072b75a",
   "metadata": {},
   "outputs": [],
   "source": [
    "mom_trk1_idx = mom_idx[ak.mask(trk1_idx, trk1_idx >= 0)]\n",
    "mom_trk2_idx = mom_idx[ak.mask(trk2_idx, trk2_idx >= 0)]\n",
    "\n",
    "mom_trk1_pdg = pdg_ids[ak.mask(mom_trk1_idx, mom_trk1_idx >= 0)]\n",
    "mom_trk2_pdg = pdg_ids[ak.mask(mom_trk2_idx, mom_trk2_idx >= 0)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "5a930a5d-b69b-4a13-a4da-fdd86d6f208a",
   "metadata": {},
   "outputs": [],
   "source": [
    "match_kstar = (mom_trk1_idx == mom_trk2_idx) & (mom_trk1_idx >= 0) & (mom_trk2_idx >= 0) & \\\n",
    "              (mom_trk1_pdg == PDG_KSTAR) & (mom_trk2_pdg == PDG_KSTAR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "c00119e1-78c7-4c29-8df4-b152262fcaf7",
   "metadata": {},
   "outputs": [],
   "source": [
    "gmom_trk1_idx = mom_idx[ak.mask(mom_trk1_idx, mom_trk1_idx >= 0)]\n",
    "gmom_trk2_idx = mom_idx[ak.mask(mom_trk2_idx, mom_trk2_idx >= 0)]\n",
    "\n",
    "gmom_trk1_pdg = pdg_ids[ak.mask(gmom_trk1_idx, gmom_trk1_idx >= 0)]\n",
    "gmom_trk2_pdg = pdg_ids[ak.mask(gmom_trk2_idx, gmom_trk2_idx >= 0)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "8fa29f43-e99d-478d-869b-05d81f07d1bb",
   "metadata": {},
   "outputs": [],
   "source": [
    "match_kstar_to_b0 = (gmom_trk1_idx == gmom_trk2_idx) & (gmom_trk1_idx >= 0) & (gmom_trk2_idx >= 0) & \\\n",
    "                    (gmom_trk1_pdg == PDG_B0) & (gmom_trk2_pdg == PDG_B0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "8706fab9-1675-4745-9a42-c4c083ab98ec",
   "metadata": {},
   "outputs": [],
   "source": [
    "mom_mu1_idx = mom_idx[ak.mask(mu1_idx, mu1_idx >= 0)]\n",
    "mom_mu2_idx = mom_idx[ak.mask(mu2_idx, mu2_idx >= 0)]\n",
    "mom_mu1_pdg = pdg_ids[ak.mask(mom_mu1_idx, mom_mu1_idx >= 0)]\n",
    "mom_mu2_pdg = pdg_ids[ak.mask(mom_mu2_idx, mom_mu2_idx >= 0)]\n",
    "\n",
    "gmom_mu1_idx = mom_idx[ak.mask(mom_mu1_idx, mom_mu1_idx >= 0)]\n",
    "gmom_mu2_idx = mom_idx[ak.mask(mom_mu2_idx, mom_mu2_idx >= 0)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "id": "1a6df5fb-133a-43b9-8d78-30c553bb1b80",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PDG ID Mãe Muon | Frequência\n",
      "------------------------------\n",
      "-15             | 1         \n",
      "22              | 965611    \n"
     ]
    }
   ],
   "source": [
    "flat_mom_mu1 = ak.to_numpy(ak.fill_none(ak.flatten(mom_mu1_pdg, axis=None), 0))\n",
    "values, counts = np.unique(flat_mom_mu1, return_counts=True)\n",
    "\n",
    "print(f\"{'PDG ID Mãe Muon':<15} | {'Frequência':<10}\")\n",
    "print(\"-\" * 30)\n",
    "for val, count in zip(values, counts):\n",
    "    label = \"None\" if val == 0 else val\n",
    "    print(f\"{label:<15} | {count:<10}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "4de1211f-9b2e-4ff6-9a9b-649b4795d665",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu1_from_same_b0 = (mom_mu1_idx == gmom_trk1_idx) | \\\n",
    "                   ((mom_mu1_pdg == PDG_PHOTON) & (gmom_mu1_idx == gmom_trk1_idx))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "d04aa2eb-265d-460b-87a7-5fbb9d9b8a95",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu2_from_same_b0 = (mom_mu2_idx == gmom_trk1_idx) | \\\n",
    "                   ((mom_mu2_pdg == PDG_PHOTON) & (gmom_mu2_idx == gmom_trk1_idx))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "82f3e22b-d69c-4ee8-8c6e-12c12d52f531",
   "metadata": {},
   "outputs": [],
   "source": [
    "full_mask = flavor_match & match_kstar & match_kstar_to_b0 & mu1_from_same_b0 & mu2_from_same_b0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 50,
   "id": "7c3e6357-f91b-4625-b53a-c33a8ad51138",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "--- LOGS DE VERIFICAÇÃO ---\n",
      "Total de candidatos: 965906\n",
      "Passaram no Matching: 632033\n",
      "Eficiência: 65.43%\n"
     ]
    }
   ],
   "source": [
    "with ProgressBar():\n",
    "    all_masses = tree[\"BToTrkTrkMuMu_fit_mass_Kpi\"].array()    \n",
    "    clean_mass = all_masses[full_mask]\n",
    "\n",
    "    n_total = ak.sum(ak.num(all_masses))\n",
    "    n_rare = ak.sum(ak.num(clean_mass))\n",
    "\n",
    "print(f\"\\n--- LOGS DE VERIFICAÇÃO ---\")\n",
    "print(f\"Total de candidatos: {n_total}\")\n",
    "print(f\"Passaram no Matching: {n_rare}\")\n",
    "print(f\"Eficiência: {100 * n_rare / n_total:.2f}%\" if n_total > 0 else \"Eficiência: 0%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "514468ae-4e2b-4771-aab0-a49720b7ecfd",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x700 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(10, 7))\n",
    "data = ak.to_numpy(ak.flatten(clean_mass, axis=None))\n",
    "\n",
    "plt.hist(data, bins=50, histtype='step', range=(5.0, 5.6), lw=2, color='red', label='B0 (Truth)')\n",
    "plt.xlabel(r\"$m(K\\pi\\mu\\mu)$ [GeV]\") \n",
    "plt.ylabel(\"Events\")\n",
    "plt.legend()\n",
    "hep.cms.label(\"Preliminary\", data=False, year=\"2022\", com=13.6) \n",
    "plt.show()"
   ]
  },
