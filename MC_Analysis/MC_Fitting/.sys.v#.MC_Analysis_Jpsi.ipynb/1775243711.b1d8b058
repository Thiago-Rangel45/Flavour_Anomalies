   "source": [
    "with ProgressBar():\n",
    "    rare_mask = get_perfect_b0_matter_mask(df)\n",
    "    kin_mask = apply_selection(df)\n",
    "    final_mask = rare_mask & kin_mask\n",
    "    clean_mass = df[\"BToTrkTrkMuMu_fit_mass_Kpi\"][final_mask]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "95c2fa4a-aa24-48fd-86b4-f65d23508b4b",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(10, 7))\n",
    "data = ak.to_numpy(ak.flatten(clean_mass.compute(), axis=None))\n",
    "plt.hist(data, bins=50, histtype='step',range=(5.0, 5.6), lw=2, color='red', label='B0 Rare Signal (Truth)')\n",
    "plt.xlabel(r\"$m_{K\\pi}$ [GeV]\")\n",
    "plt.ylabel(\"Events\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }
 ],
