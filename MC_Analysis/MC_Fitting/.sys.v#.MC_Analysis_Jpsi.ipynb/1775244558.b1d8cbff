      "alphal             1.17883  -  0.028   +  0.029       False\n",
      "nl                 4.30159  -   0.25   +   0.27       False\n",
      "alphar             1.23179  -  0.032   +  0.032       False\n",
      "nr                 14.9383  -    2.2   +    2.9       False\n"
     ]
    }
   ],
   "source": [
    "result.errors()\n",
    "print(f\"Fit Convergiu? {result.converged}\")\n",
    "print(result)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "707235b8-70af-4029-93b3-102a915bb5ef",
   "metadata": {},
   "outputs": [
