   "source": [
    "# --- 1. Extração dos Parâmetros do Modelo ---\n",
    "mu_val = model.params['mu'].numpy()\n",
    "sigma_val = model.params['sigma'].numpy()\n",
    "\n",
    "# Definição das fronteiras para o sombreamento no plot principal\n",
    "sig_low, sig_high = mu_val - 3*sigma_val, mu_val + 3*sigma_val\n",
    "bg_neg_low, bg_neg_high = mu_val - 7*sigma_val, mu_val - 3*sigma_val\n",
    "bg_pos_low, bg_pos_high = mu_val + 3*sigma_val, mu_val + 7*sigma_val\n",
    "\n",
    "# --- 2. Configuração do Gráfico (Grid com 2 subplots) ---\n",
    "fig = plt.figure(figsize=(10, 10))\n",
    "gs = gridspec.GridSpec(2, 1, height_ratios=[3, 1], hspace=0.05) \n",
    "ax1 = plt.subplot(gs[0])\n",
    "ax2 = plt.subplot(gs[1])\n",
    "\n",
    "# --- 3. Subplot Superior: Dados, Fit e Shading ---\n",
    "hep.histplot(counts, bins=bin_edges, ax=ax1, color='black', label='MC Signal', histtype='errorbar')\n",
    "ax1.plot(x_plot, y_plot, color='red', lw=3, label='DoubleCB Fit')\n",
    "\n",
    "# Sombreamento Vertical apenas no ax1\n",
    "ax1.axvspan(sig_low, sig_high, color='red', alpha=0.15, label=r'Signal Region ($\\pm 3\\sigma$)')\n",
    "ax1.axvspan(bg_neg_low, bg_neg_high, color='gray', alpha=0.2, label=r'Sidebands ($3-7\\sigma$)')\n",
    "ax1.axvspan(bg_pos_low, bg_pos_high, color='gray', alpha=0.2)\n",
    "\n",
    "# Estética ax1\n",
    "ax1.set_ylabel(f\"Events / {bin_width:.3f} GeV\", fontsize=18)\n",
    "#ax1.set_xlim(bin_range)\n",
    "ax1.set_ylim(0, max(counts) * 1.5) \n",
    "ax1.legend(loc='upper right', fontsize=12, frameon=True)\n",
    "hep.cms.label(\"Work in Progress\", data=False, year=\"2022\", ax=ax1, com=13.6, fontsize=20)\n",
    "ax1.tick_params(axis='x', labelbottom=False)\n",
    "\n",
    "# --- 4. Subplot Inferior: Pull Plot (Original) ---\n",
    "pulls = (counts - expected) / np.sqrt(counts, where=counts>0)\n",
    "ax2.errorbar(bin_centers, pulls, yerr=1, fmt='o', color='black', markersize=4, capsize=0)\n",
    "ax2.axhline(0, color='red', linestyle='-', lw=1)\n",
    "\n",
    "# Faixas de sigma do Pull (Verde/Amarelo)\n",
    "ax2.fill_between(bin_range, -1, 1, color='green', alpha=0.2)\n",
    "ax2.fill_between(bin_range, -2, 2, color='yellow', alpha=0.1)\n",
    "\n",
    "ax2.set_xlabel(r\"$m(K^{+}\\pi^{-}\\mu^{+}\\mu^{-})$ [GeV]\", fontsize=18)\n",
    "ax2.set_ylabel(\"Pull\", fontsize=18)\n",
    "ax2.set_ylim(-5, 5)\n",
    "ax2.set_xlim(bin_range)\n",
    "ax2.grid(axis='y', linestyle=':', alpha=0.6)\n",
    "\n",
    "plt.subplots_adjust(left=0.15, right=0.95, top=0.95, bottom=0.12)\n",
    "plt.show()"
   ]
  },
