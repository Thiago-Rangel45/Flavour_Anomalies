     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(10, 7))\n",
    "num_bins = 80\n",
    "counts, bin_edges = np.histogram(data, bins=num_bins, range=(mass_min, mass_max))\n",
    "bin_width = (mass_max - mass_min) / num_bins\n",
    "\n",
    "x_plot = np.linspace(mass_min, mass_max, 1000)\n",
    "y_plot = model.pdf(x_plot).numpy() * len(data) * bin_width\n",
    "\n",
    "hep.histplot(counts, bins=bin_edges, color='black', label='MC Signal', histtype='errorbar')\n",
    "plt.plot(x_plot, y_plot, color='darkred', lw=3, label='DoubleCB Fit')\n",
    "\n",
    "plt.xlabel(r\"$m(K\\pi\\mu\\mu)$ [GeV]\")\n",
    "plt.ylabel(f\"Events / {bin_width:.3f} GeV\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "5601bbe2-d3a6-4ef0-b51d-16e891e09c22",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Matriz de Covariância:\n",
      "[[ 4.59352882e-08 -8.91522123e-09 -2.38931513e-06  1.86143577e-05\n",
