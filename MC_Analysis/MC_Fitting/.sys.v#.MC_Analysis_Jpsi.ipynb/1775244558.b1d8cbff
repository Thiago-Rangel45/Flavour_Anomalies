     ]
    }
   ],
   "source": [
    "cov_matrix = result.covariance()\n",
    "print(\"Matriz de Covariância:\")\n",
    "print(cov_matrix)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "a5341662-d666-41fc-a513-790ca21b0243",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Log-Likelihood mínimo: -86174.76\n",
      "Chi2: 78.99\n",
      "NDF: 74\n",
      "Chi2/NDF: 1.07\n"
     ]
    }
   ],
   "source": [
    "nll_value = result.fmin\n",
    "print(f\"Log-Likelihood mínimo: {nll_value:.2f}\")\n",
    "\n",
    "\n",
    "counts, bin_edges = np.histogram(data, bins=80, range=(5.0, 5.6))\n",
    "bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2\n",
    "bin_width = bin_edges[1] - bin_edges[0]\n",
    "\n",
    "expected_counts = model.pdf(bin_centers).numpy() * len(data) * bin_width\n",
    "mask = counts > 0\n",
    "chi2 = np.sum(((counts[mask] - expected_counts[mask])**2) / expected_counts[mask])\n",
    "n_params = len(result.params)\n",
    "ndf = len(counts) - n_params\n",
    "\n",
    "print(f\"Chi2: {chi2:.2f}\")\n",
    "print(f\"NDF: {ndf}\")\n",
    "print(f\"Chi2/NDF: {chi2/ndf:.2f}\")"
   ]
  },
  {
