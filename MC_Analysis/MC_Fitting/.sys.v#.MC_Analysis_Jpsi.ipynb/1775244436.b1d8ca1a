   ],
   "source": [
    "import uproot\n",
    "import dask_awkward as dak\n",
    "import awkward as ak\n",
    "import zfit\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "import mplhep as hep\n",
    "from dask.diagnostics import ProgressBar"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "21c91b03-185f-4d6d-b08a-c7967a71bd81",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.style.use(hep.style.CMS)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "3431ccc1-d097-4372-9dcb-1c040cb0847f",
   "metadata": {},
   "outputs": [],
   "source": [
    "mc_files = {\"/eos/user/t/tdeandra/skim_outputs/Merged_Eras/Merged_mc_jpsi_2022.root\": \"Events\"}\n",
    "df = uproot.dask(mc_files)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "9b027394-fb29-450e-b117-d11af5a29817",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_perfect_b0_matter_mask(df):\n",
    "    PDG_B0        =  511\n",
    "    PDG_KSTAR     =  313\n",
    "    PDG_KAON_plus =  321\n",
    "    PDG_PION_neg  = -211\n",
    "    PDG_PHOTON    =  22\n",
    "    PDG_JPSI      =  443\n",
    "    PDG_MUON_plus = -13\n",
    "    PDG_MUON_neg  =  13\n",
    "\n",
    "    pdg_ids = df[\"BPHGenPart_pdgId\"]\n",
    "    mom_idx = df[\"BPHGenPart_genPartIdxMother\"]\n",
    "    \n",
    "    mu1_idx  = df[\"BPH_1Muon_genPartIdx\"]\n",
    "    mu2_idx  = df[\"BPH_2Muon_genPartIdx\"]\n",
    "    trk1_idx = df[\"Trk1_genPartIdx\"]\n",
    "    trk2_idx = df[\"Trk2_genPartIdx\"]\n",
    "\n",
    "    mu1_pdg  = pdg_ids[ak.mask(mu1_idx, mu1_idx >= 0)]\n",
    "    mu2_pdg  = pdg_ids[ak.mask(mu2_idx, mu2_idx >= 0)]\n",
    "    trk1_pdg = pdg_ids[ak.mask(trk1_idx, trk1_idx >= 0)]\n",
    "    trk2_pdg = pdg_ids[ak.mask(trk2_idx, trk2_idx >= 0)]\n",
    "\n",
    "    flavor_match = (trk1_pdg == PDG_KAON_plus) & (trk2_pdg == PDG_PION_neg) & \\\n",
    "                   (mu1_pdg == PDG_MUON_plus) & (mu2_pdg == PDG_MUON_neg)\n",
    "\n",
    "    mom_trk1_idx = mom_idx[ak.mask(trk1_idx, trk1_idx >= 0)]\n",
    "    mom_trk2_idx = mom_idx[ak.mask(trk2_idx, trk2_idx >= 0)]\n",
    "    mom_trk1_pdg = pdg_ids[ak.mask(mom_trk1_idx, mom_trk1_idx >= 0)]\n",
    "    mom_trk2_pdg = pdg_ids[ak.mask(mom_trk2_idx, mom_trk2_idx >= 0)]\n",
    "\n",
    "    match_kstar = (mom_trk1_idx == mom_trk2_idx) & (mom_trk1_idx >= 0) & (mom_trk2_idx >= 0) & \\\n",
    "                  (mom_trk1_pdg == PDG_KSTAR) & (mom_trk2_pdg == PDG_KSTAR)\n",
    "\n",
    "    gmom_trk1_idx = mom_idx[ak.mask(mom_trk1_idx, mom_trk1_idx >= 0)]\n",
    "    gmom_trk2_idx = mom_idx[ak.mask(mom_trk2_idx, mom_trk2_idx >= 0)]    \n",
    "    gmom_trk1_pdg = pdg_ids[ak.mask(gmom_trk1_idx, gmom_trk1_idx >= 0)]\n",
    "    gmom_trk2_pdg = pdg_ids[ak.mask(gmom_trk2_idx, gmom_trk2_idx >= 0)]\n",
    "\n",
    "    match_kstar_to_b0 = (gmom_trk1_idx == gmom_trk2_idx) & (gmom_trk1_idx >= 0) & (gmom_trk2_idx >= 0) & \\\n",
    "                        (gmom_trk1_pdg == PDG_B0) & (gmom_trk2_pdg == PDG_B0)\n",
    "\n",
    "    mom_mu1_idx = mom_idx[ak.mask(mu1_idx, mu1_idx >= 0)]\n",
    "    mom_mu2_idx = mom_idx[ak.mask(mu2_idx, mu2_idx >= 0)]\n",
    "    gmom_mu1_idx = mom_idx[ak.mask(mom_mu1_idx, mom_mu1_idx >= 0)]\n",
    "    gmom_mu2_idx = mom_idx[ak.mask(mom_mu2_idx, mom_mu2_idx >= 0)]\n",
    "\n",
    "    mom_mu1_pdg = pdg_ids[ak.mask(mom_mu1_idx, mom_mu1_idx >= 0)]\n",
    "    mom_mu2_pdg = pdg_ids[ak.mask(mom_mu2_idx, mom_mu2_idx >= 0)]    \n",
    "    gmom_mu1_pdg = pdg_ids[ak.mask(gmom_mu1_idx, gmom_mu1_idx >= 0)]\n",
    "    gmom_mu2_pdg = pdg_ids[ak.mask(gmom_mu2_idx, gmom_mu2_idx >= 0)]\n",
    "\n",
    "    ggmom_mu1_idx = mom_idx[ak.mask(gmom_mu1_idx, gmom_mu1_idx >= 0)]\n",
    "    ggmom_mu2_idx = mom_idx[ak.mask(gmom_mu2_idx, gmom_mu2_idx >= 0)]    \n",
    "    ggmom_mu1_pdg = pdg_ids[ak.mask(ggmom_mu1_idx, ggmom_mu1_idx >= 0)]\n",
    "    ggmom_mu2_pdg = pdg_ids[ak.mask(ggmom_mu2_idx, ggmom_mu2_idx >= 0)]\n",
    "\n",
    "    mu1_match = (mom_mu1_idx == gmom_trk1_idx) | \\\n",
    "                ((mom_mu1_pdg == PDG_PHOTON) & (gmom_mu2_pdg == PDG_JPSI) & (ggmom_mu1_idx == gmom_trk1_idx))\n",
    "\n",
    "    mu2_match = (mom_mu2_idx == gmom_trk1_idx) | \\\n",
    "            ((mom_mu2_pdg == PDG_PHOTON) & (gmom_mu2_pdg == PDG_JPSI) & (ggmom_mu2_idx == gmom_trk1_idx))\n",
    "    truth_match_final = flavor_match & match_kstar & match_kstar_to_b0 & mu1_match & mu2_match\n",
    "\n",
    "    return ak.fill_none(truth_match_final, False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "8a41e31f-ae60-4208-8b7f-0e035463b941",
   "metadata": {},
   "outputs": [],
   "source": [
    "def apply_selection(df):\n",
    "    mask = (        \n",
    "        # --- Ressonância (J/psi) ---\n",
    "        (((df['MuMu_mass'] > 2.9) & (df['MuMu_mass'] < 3.3)) &\n",
    "        \n",
    "        # --- Seleção do K*0 (892) ---\n",
    "        (abs(df['BToTrkTrkMuMu_fit_ditrack_mass_Kpi'] - 0.892) <= 0.150) & \n",
    "        (abs(df['BToTrkTrkMuMu_fit_ditrack_mass_piK'] - 0.892) <= 0.150) & \n",
    "        (df['BToTrkTrkMuMu_fit_ditrack_mass_Kpi'] < df['BToTrkTrkMuMu_fit_ditrack_mass_piK']) & \n",
    "        \n",
    "        # --- Aceitação dos Múons ---\n",
    "        (df['BPH_1Muon_pt'] > 4.0) & (df['BPH_2Muon_pt'] > 4.0) & \n",
    "        (abs(df['BPH_1Muon_eta']) < 2.5) & (abs(df['BPH_2Muon_eta']) < 2.5)\n",
    "    ))\n",
    "    \n",
    "    return ak.fill_none(mask, False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "8d21fcd5-1886-4210-8622-fd0821dfec2c",
   "metadata": {},
   "outputs": [],
   "source": [
    "with ProgressBar():\n",
    "    rare_mask = get_perfect_b0_matter_mask(df)\n",
    "    kin_mask = apply_selection(df)\n",
    "    final_mask = rare_mask & kin_mask\n",
    "    clean_mass = df[\"BToTrkTrkMuMu_fit_mass_Kpi\"][final_mask]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "95c2fa4a-aa24-48fd-86b4-f65d23508b4b",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x700 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(10, 7))\n",
    "data = ak.to_numpy(ak.flatten(clean_mass.compute(), axis=None))\n",
    "plt.hist(data, bins=50, histtype='step',range=(5.0, 5.6), lw=2, color='red', label='B0 Rare Signal (Truth)')\n",
    "plt.xlabel(r\"$m_{K\\pi}$ [GeV]\")\n",
    "plt.ylabel(\"Events\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "03ce5221-e34e-4a99-a214-e8b11a0cd5a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "mass_min, mass_max = 5.0, 5.6\n",
    "obs = zfit.Space(\"m_b\", limits=(mass_min, mass_max))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "c9abda7f-35b3-43f5-87ac-8639960730e4",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu    = zfit.Parameter(\"mu\", 5.279, 5.2, 5.4)\n",
    "sigma = zfit.Parameter(\"sigma\", 0.02, 0.001, 0.1)\n",
    "alphal = zfit.Parameter(\"alphal\", 1.5, 0.1, 5.0)\n",
    "nl     = zfit.Parameter(\"nl\", 2.0, 0.1, 30.0)\n",
    "alphar = zfit.Parameter(\"alphar\", 1.5, 0.1, 5.0)\n",
    "nr     = zfit.Parameter(\"nr\", 2.0, 0.1, 30.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "22ef32b8-896e-406f-b8f1-a973e2488614",
   "metadata": {},
   "outputs": [],
   "source": [
    "model = zfit.pdf.DoubleCB(obs=obs, mu=mu, sigma=sigma, \n",
    "                          alphal=alphal, nl=nl, alphar=alphar, nr=nr)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "96415544-cef1-45e9-8105-0b927d442c00",
   "metadata": {},
   "outputs": [],
   "source": [
    "zfit_data = zfit.Data.from_numpy(obs=obs, array=data)\n",
    "nll = zfit.loss.UnbinnedNLL(model=model, data=zfit_data)\n",
    "minimizer = zfit.minimize.Minuit()\n",
    "result = minimizer.minimize(nll)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "f148dbed-9868-4e1c-957f-75491311d253",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Fit Convergiu? True\n",
      "FitResult of\n",
      "<UnbinnedNLL model=[<zfit.<class 'zfit.models.physics.DoubleCB'>  params=[alphal, alphar, mu, nl, nr, sigma]] data=[<zfit.Data: Data obs=('m_b',) shape=(50159, 1)>] constraints=[]> \n",
      "with\n",
      "<Minuit Minuit, tol=0.001>\n",
      "\n",
      "╒═════════╤═════════════╤══════════════════╤═══════╤══════════════════════════════╕\n",
      "│  valid  │  converged  │  param at limit  │  edm  │   approx. fmin (full | opt.) │\n",
      "╞═════════╪═════════════╪══════════════════╪═══════╪══════════════════════════════╡\n",
      "│  True   │    True     │      False       │ 2e-07 │        -86174.76 |  6430.093 │\n",
      "╘═════════╧═════════════╧══════════════════╧═══════╧══════════════════════════════╛\n",
      "\n",
      "Parameters\n",
      "name      value  (rounded)               errors    at limit\n",
      "------  ------------------  -------------------  ----------\n",
      "mu                 5.27981  -0.00022   +0.00022       False\n",
      "sigma             0.029488  -0.00032   +0.00031       False\n",
      "alphal             1.17883  -  0.028   +  0.029       False\n",
      "nl                 4.30159  -   0.25   +   0.27       False\n",
      "alphar             1.23179  -  0.032   +  0.032       False\n",
      "nr                 14.9383  -    2.2   +    2.9       False\n"
     ]
    }
   ],
   "source": [
    "result.errors()\n",
    "print(f\"Fit Convergiu? {result.converged}\")\n",
    "print(result)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "707235b8-70af-4029-93b3-102a915bb5ef",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x700 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(10, 7))\n",
    "num_bins = 80\n",
    "counts, bin_edges = np.histogram(data, bins=num_bins, range=(mass_min, mass_max))\n",
    "bin_width = (mass_max - mass_min) / num_bins\n",
    "\n",
    "x_plot = np.linspace(mass_min, mass_max, 1000)\n",
    "y_plot = model.pdf(x_plot).numpy() * len(data) * bin_width\n",
    "\n",
    "hep.histplot(counts, bins=bin_edges, color='black', label='MC Signal', histtype='errorbar')\n",
    "plt.plot(x_plot, y_plot, color='darkred', lw=3, label='DoubleCB Fit')\n",
    "\n",
    "plt.xlabel(r\"$m(K\\pi\\mu\\mu)$ [GeV]\")\n",
    "plt.ylabel(f\"Events / {bin_width:.3f} GeV\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "5601bbe2-d3a6-4ef0-b51d-16e891e09c22",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
