      "nl                 3.70149  -   0.34   +   0.39       False\n",
      "alphar             1.28646  -  0.055   +  0.054       False\n",
      "nr                 9.89551  -    1.7   +    2.5       False\n"
     ]
    }
   ],
   "source": [
    "result.errors()\n",
    "print(f\"Fit Convergiu? {result.converged}\")\n",
    "print(result)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "fc51815b-bf28-4459-9ecd-fed959c36fb2",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x700 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(10, 7))\n",
    "num_bins = 80\n",
    "counts, bin_edges = np.histogram(data, bins=num_bins, range=(mass_min, mass_max))\n",
    "bin_width = (mass_max - mass_min) / num_bins\n",
    "\n",
    "x_plot = np.linspace(mass_min, mass_max, 1000)\n",
    "y_plot = model.pdf(x_plot).numpy() * len(data) * bin_width\n",
    "\n",
    "hep.histplot(counts, bins=bin_edges, color='black', label='MC Signal', histtype='errorbar')\n",
    "plt.plot(x_plot, y_plot, color='darkred', lw=3, label='DoubleCB Fit')\n",
    "\n",
    "plt.xlabel(r\"$m(K\\pi\\mu\\mu)$ [GeV]\")\n",
    "plt.ylabel(f\"Events / {bin_width:.3f} GeV\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "f9dc75d6-024f-471e-8822-d8bdc0af9a5b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Matriz de Covariância:\n",
      "[[ 1.29390217e-07  2.09896208e-09 -4.99266037e-06  3.14961680e-05\n",
