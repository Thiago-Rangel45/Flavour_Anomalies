   "source": [
    "import uproot\n",
    "import dask_awkward as dak\n",
    "import awkward as ak\n",
    "import zfit\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "import mplhep as hep\n",
    "from dask.diagnostics import ProgressBar"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "d9175717-bc4d-4a11-8fb3-bbbe59f6c692",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.style.use(hep.style.CMS)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "6c8da088-96f9-4920-a734-f3eec4e90c66",
   "metadata": {},
   "outputs": [],
   "source": [
    "mc_files = {\"/eos/user/t/tdeandra/skim_outputs/Merged_Eras/Merged_mc_signal_2022.root\": \"Events\"}\n",
    "df = uproot.dask(mc_files)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "9ab8ac5f-b9ba-427b-b32a-0c6d6484c275",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_perfect_b0_matter_mask(df):\n",
    "    # --- 1. Constantes PDG ---\n",
    "    PDG_B0        = 511\n",
    "    PDG_KSTAR     = 313\n",
    "    PDG_KAON_plus = 321\n",
    "    PDG_PION_neg  = -211\n",
    "    PDG_MUON_plus = -13\n",
    "    PDG_MUON_neg  = 13\n",
    "    PDG_PHOTON    = 22\n",
    "\n",
    "    mu1_idx  = df[\"BPH_1Muon_genPartIdx\"]\n",
    "    mu2_idx  = df[\"BPH_2Muon_genPartIdx\"]\n",
    "    trk1_idx = df[\"Trk1_genPartIdx\"]\n",
    "    trk2_idx = df[\"Trk2_genPartIdx\"]\n",
    "\n",
    "    # Verificação de Identidade (PDG ID)\n",
    "    mu1_pdg  = df[\"BPHGenPart_pdgId\"][dak.mask(mu1_idx, mu1_idx >= 0)]\n",
    "    mu2_pdg  = df[\"BPHGenPart_pdgId\"][dak.mask(mu2_idx, mu2_idx >= 0)]\n",
    "    trk1_pdg = df[\"BPHGenPart_pdgId\"][dak.mask(trk1_idx, trk1_idx >= 0)]\n",
    "    trk2_pdg = df[\"BPHGenPart_pdgId\"][dak.mask(trk2_idx, trk2_idx >= 0)]\n",
    "\n",
    "    flavor_match = (trk1_pdg == PDG_KAON_plus) & (trk2_pdg == PDG_PION_neg) & \\\n",
    "                   (mu1_pdg == PDG_MUON_plus) & (mu2_pdg == PDG_MUON_neg)\n",
    "\n",
    "    # Linhagem do Hadron (K, Pi -> K* -> B0)\n",
    "    mom_trk1_idx = df[\"BPHGenPart_genPartIdxMother\"][dak.mask(trk1_idx, trk1_idx >= 0)]\n",
    "    mom_trk2_idx = df[\"BPHGenPart_genPartIdxMother\"][dak.mask(trk2_idx, trk2_idx >= 0)]\n",
    "    \n",
    "    mom_trk1_pdg = df[\"BPHGenPart_pdgId\"][dak.mask(mom_trk1_idx, mom_trk1_idx >= 0)]\n",
    "    mom_trk2_pdg = df[\"BPHGenPart_pdgId\"][dak.mask(mom_trk2_idx, mom_trk2_idx >= 0)]\n",
    "    \n",
    "    # K e Pi devem vir do mesmo objeto K*0 \n",
    "    match_kstar = (mom_trk1_idx == mom_trk2_idx) & (mom_trk1_idx >= 0) & \\\n",
    "                  (mom_trk1_pdg == PDG_KSTAR) & (mom_trk2_pdg == PDG_KSTAR)\n",
    "    \n",
    "    # O K*0 deve vir de um B0 (Verificando para ambos os traços)\n",
    "    gmom_trk1_idx = df[\"BPHGenPart_genPartIdxMother\"][dak.mask(mom_trk1_idx, mom_trk1_idx >= 0)]\n",
    "    gmom_trk2_idx = df[\"BPHGenPart_genPartIdxMother\"][dak.mask(mom_trk2_idx, mom_trk2_idx >= 0)]\n",
    "    \n",
    "    gmom_trk1_pdg = df[\"BPHGenPart_pdgId\"][dak.mask(gmom_trk1_idx, gmom_trk1_idx >= 0)]\n",
    "    gmom_trk2_pdg = df[\"BPHGenPart_pdgId\"][dak.mask(gmom_trk2_idx, gmom_trk2_idx >= 0)]\n",
    "    \n",
    "    match_kstar_to_b0 = (gmom_trk1_idx == gmom_trk2_idx) & (gmom_trk1_idx >= 0) & \\\n",
    "                        (gmom_trk1_pdg == PDG_B0) & (gmom_trk2_pdg == PDG_B0)\n",
    "\n",
    "    mom_mu1_idx = df[\"BPHGenPart_genPartIdxMother\"][dak.mask(mu1_idx, mu1_idx >= 0)]\n",
    "    mom_mu2_idx = df[\"BPHGenPart_genPartIdxMother\"][dak.mask(mu2_idx, mu2_idx >= 0)]\n",
    "    mom_mu1_pdg = df[\"BPHGenPart_pdgId\"][dak.mask(mom_mu1_idx, mom_mu1_idx >= 0)]\n",
    "    mom_mu2_pdg = df[\"BPHGenPart_pdgId\"][dak.mask(mom_mu2_idx, mom_mu2_idx >= 0)]\n",
    "    \n",
    "    gmom_mu1_idx = df[\"BPHGenPart_genPartIdxMother\"][dak.mask(mom_mu1_idx, mom_mu1_idx >= 0)]\n",
    "    gmom_mu2_idx = df[\"BPHGenPart_genPartIdxMother\"][dak.mask(mom_mu2_idx, mom_mu2_idx >= 0)]\n",
    "\n",
    "    # Muon 1: Mãe é o B0 do hadron OU (Mãe é fóton e Avô é o B0 do hadron)\n",
    "    mu1_from_same_b0 = (mom_mu1_idx == gmom_trk1_idx) | \\\n",
    "                       ((mom_mu1_pdg == PDG_PHOTON) & (gmom_mu1_idx == gmom_trk1_idx))\n",
    "\n",
    "    mu2_from_same_b0 = (mom_mu2_idx == gmom_trk1_idx) | \\\n",
    "                       ((mom_mu2_pdg == PDG_PHOTON) & (gmom_mu2_idx == gmom_trk1_idx))\n",
    "\n",
    "    # --- Máscara Final ---\n",
    "    full_mask = flavor_match & match_kstar & match_kstar_to_b0 & \\\n",
    "                mu1_from_same_b0 & mu2_from_same_b0\n",
    "    \n",
    "    return ak.fill_none(full_mask, False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "9835455d-59a5-4f0e-b15d-4b83d17106f2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def apply_selection(df):\n",
    "    mask = (        \n",
    "        # --- Veto de Ressonâncias (J/psi e psi(2S)) ---\n",
    "        (((df['MuMu_mass'] > 1.0) & (df['MuMu_mass'] < 2.7)) | \n",
    "         ((df['MuMu_mass'] > 4.0) & (df['MuMu_mass'] < 6.0))) & \n",
    "        \n",
    "        # --- Seleção do K*0 (892) ---\n",
    "        (abs(df['BToTrkTrkMuMu_fit_ditrack_mass_Kpi'] - 0.892) <= 0.150) & \n",
    "        (abs(df['BToTrkTrkMuMu_fit_ditrack_mass_piK'] - 0.892) <= 0.150) & \n",
    "        (df['BToTrkTrkMuMu_fit_ditrack_mass_Kpi'] < df['BToTrkTrkMuMu_fit_ditrack_mass_piK']) & \n",
    "        \n",
    "        # --- Aceitação dos Múons ---\n",
    "        (df['BPH_1Muon_pt'] > 2.0) & (df['BPH_2Muon_pt'] > 2.0) & \n",
    "        (abs(df['BPH_1Muon_eta']) < 2.5) & (abs(df['BPH_2Muon_eta']) < 2.5) &\n",
    "        (df['BToTrkTrkMuMu_fit_trk1_pt'] > 1.5) &\n",
    "        (df['BToTrkTrkMuMu_fit_trk2_pt'] > 1.5) \n",
    "    )\n",
    "    \n",
    "    return ak.fill_none(mask, False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "b5b6ea07-555e-4328-abc6-d8148d42d19c",
   "metadata": {},
   "outputs": [],
   "source": [
    "with ProgressBar():\n",
    "    rare_mask = get_perfect_b0_matter_mask(df)\n",
    "    kin_mask = apply_selection(df)\n",
    "    final_mask = rare_mask & kin_mask\n",
    "    clean_mass = df[\"BToTrkTrkMuMu_fit_mass_Kpi\"][final_mask]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "4fa31802-4d59-48cd-b61d-c0f507ec56d8",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x700 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(10, 7))\n",
    "data = ak.to_numpy(ak.flatten(clean_mass.compute(), axis=None))\n",
    "plt.hist(data, bins=50, histtype='step',range=(5.0, 5.6), lw=2, color='red', label='B0 Rare Signal (Truth)')\n",
    "plt.xlabel(r\"$m_{K\\pi}$ [GeV]\")\n",
    "plt.ylabel(\"Events\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "0bdb2d16-6c1e-4cc8-b0b2-2133d806eb9f",
   "metadata": {},
   "outputs": [],
   "source": [
    "mass_min, mass_max = 5.0, 5.6\n",
    "obs = zfit.Space(\"m_b\", limits=(mass_min, mass_max))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "ad330b1f-67ff-416a-ab7a-704c19632f62",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu    = zfit.Parameter(\"mu\", 5.279, 5.2, 5.4)\n",
    "sigma = zfit.Parameter(\"sigma\", 0.02, 0.001, 0.1)\n",
    "alphal = zfit.Parameter(\"alphal\", 1.5, 0.1, 5.0)\n",
    "nl     = zfit.Parameter(\"nl\", 2.0, 0.1, 30.0)\n",
    "alphar = zfit.Parameter(\"alphar\", 1.5, 0.1, 5.0)\n",
    "nr     = zfit.Parameter(\"nr\", 2.0, 0.1, 30.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "025ae31d-4dcb-4f55-9b07-b8662ea93f03",
   "metadata": {},
   "outputs": [],
   "source": [
    "model = zfit.pdf.DoubleCB(obs=obs, mu=mu, sigma=sigma, \n",
    "                          alphal=alphal, nl=nl, alphar=alphar, nr=nr\n",
    "                          )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "f3464c35-8738-4f1a-8c6f-1fab30278c42",
   "metadata": {},
   "outputs": [],
   "source": [
    "zfit_data = zfit.Data.from_numpy(obs=obs, array=data)\n",
    "nll = zfit.loss.UnbinnedNLL(model=model, data=zfit_data)\n",
    "minimizer = zfit.minimize.Minuit()\n",
    "result = minimizer.minimize(nll)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "1bf969c6-91b9-47e4-9ca8-0fa136da6a90",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Fit Convergiu? True\n",
