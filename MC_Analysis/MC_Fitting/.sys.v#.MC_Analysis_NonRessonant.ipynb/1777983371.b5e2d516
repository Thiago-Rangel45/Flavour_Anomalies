   ],
   "source": [
    "res_raw = result.info['original']\n",
    "fmin = res_raw.fmin if hasattr(res_raw, 'fmin') else res_raw\n",
    "\n",
    "print(f\"--- STATUS DO MINUIT (covQ) ---\")\n",
