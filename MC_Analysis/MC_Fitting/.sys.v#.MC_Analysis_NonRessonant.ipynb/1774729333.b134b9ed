   "source": [
    "# Acessar a matriz de covariância completa\n",
    "cov_matrix = result.covariance()\n",
    "print(\"Matriz de Covariância:\")\n",
    "print(cov_matrix)\n",
    "\n",
    "# Acessar a matriz de correlação (mais fácil de ler, valores de -1 a 1)\n",
    "corr_matrix = result.correlation()\n",
    "print(\"\\nMatriz de Correlação:\")\n",
    "print(corr_matrix)"
   ]
