   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Log-Likelihood mínimo: -541851.71\n",
      "Chi2: 509.56\n",
      "NDF: 74\n",
      "Chi2/NDF: 6.89\n"
     ]
    }
   ],
   "source": [
    "# 1. Obter o valor final do log-likelihood (NLL)\n",
    "nll_value = result.fmin\n",
    "print(f\"Log-Likelihood mínimo: {nll_value:.2f}\")\n",
    "\n",
    "# 2. Calcular o chi2 manual comparando o modelo com o histograma\n",
    "# Pegamos os valores do histograma que você plotou\n",
    "counts, bin_edges = np.histogram(data, bins=80, range=(5.0, 5.6))\n",
    "bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2\n",
    "bin_width = bin_edges[1] - bin_edges[0]\n",
    "\n",
    "# Valor esperado pelo modelo em cada centro de bin\n",
    "expected_counts = model.pdf(bin_centers).numpy() * len(data) * bin_width\n",
    "\n",
    "# Cálculo do chi2 (Pearson's chi-square)\n",
    "# Filtramos bins com zero para evitar divisão por zero\n",
    "mask = counts > 0\n",
    "chi2 = np.sum(((counts[mask] - expected_counts[mask])**2) / expected_counts[mask])\n",
    "\n",
    "# Graus de Liberdade (NDF) = Número de Bins - Número de Parâmetros Livres\n",
    "n_params = len(result.params)\n",
    "ndf = len(counts) - n_params\n",
    "\n",
    "print(f\"Chi2: {chi2:.2f}\")\n",
    "print(f\"NDF: {ndf}\")\n",
    "print(f\"Chi2/NDF: {chi2/ndf:.2f}\")"
   ]
  },
