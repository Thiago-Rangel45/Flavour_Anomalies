    "import matplotlib.gridspec as gridspec\n",
    "\n",
    "# --- 1. Preparação dos Dados (Garantindo que as variáveis existem) ---\n",
    "num_bins = 80\n",
    "bin_range = (5.0, 5.6)\n",
    "counts, bin_edges = np.histogram(data, bins=num_bins, range=bin_range)\n",
    "bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2\n",
    "bin_width = (bin_range[1] - bin_range[0]) / num_bins\n",
    "\n",
    "# Calculando a curva do modelo (expected) para o Chi2 e para o Pull\n",
    "# PDF * Total de Eventos * Largura do Bin\n",
    "x_plot = np.linspace(bin_range[0], bin_range[1], 1000)\n",
    "y_plot = model.pdf(x_plot).numpy() * len(data) * bin_width\n",
    "expected = model.pdf(bin_centers).numpy() * len(data) * bin_width\n",
    "\n",
    "# --- 2. Configuração do Gráfico (Grid com 2 subplots) ---\n",
    "fig = plt.figure(figsize=(10, 10))\n",
    "gs = gridspec.GridSpec(2, 1, height_ratios=[3, 1], hspace=0.07)\n",
    "ax1 = plt.subplot(gs[0])\n",
    "ax2 = plt.subplot(gs[1])\n",
    "\n",
    "# --- 3. Subplot Superior: Histograma e Fit ---\n",
    "hep.histplot(counts, bins=bin_edges, ax=ax1, color='black', label='MC Signal', histtype='errorbar')\n",
    "ax1.plot(x_plot, y_plot, color='red', lw=3, label='DoubleCB Fit (covQ=3)')\n",
    "\n",
    "ax1.set_ylabel(f\"Events / {bin_width:.3f} GeV\", fontsize=18)\n",
    "ax1.set_xlim(bin_range)\n",
    "ax1.legend(loc='upper right', fontsize=14)\n",
    "hep.cms.label(\"Preliminary\", data=False, year=\"2022\", ax=ax1)\n",
    "\n",
    "# --- 4. Subplot Inferior: Pull Plot (Resíduos) ---\n",
    "# Pull = (Dados - Modelo) / Erro(Dados)\n",
    "# Onde Erro(Dados) = sqrt(N)\n",
    "pulls = (counts - expected) / np.sqrt(counts, where=counts>0)\n",
    "\n",
    "ax2.errorbar(bin_centers, pulls, yerr=1, fmt='o', color='black', markersize=4, capsize=0)\n",
    "ax2.axhline(0, color='red', linestyle='-', lw=1)\n",
    "\n",
    "# Adicionando faixas coloridas para as sigmas\n",
    "ax2.axhline(1, color='gray', linestyle='--', alpha=0.5)\n",
    "ax2.axhline(-1, color='gray', linestyle='--', alpha=0.5)\n",
    "ax2.fill_between(bin_range, -1, 1, color='green', alpha=0.2)   # 1 sigma\n",
    "ax2.fill_between(bin_range, -2, 2, color='yellow', alpha=0.1)  # 2 sigmas\n",
    "\n",
    "ax2.set_xlabel(r\"$m(K\\pi\\mu\\mu)$ [GeV]\", fontsize=18)\n",
    "ax2.set_ylabel(\"Pull\", fontsize=18)\n",
    "ax2.set_ylim(-5, 5) # Pulls geralmente ficam entre -3 e 3\n",
    "ax2.set_xlim(bin_range)\n",
    "ax2.grid(axis='y', linestyle=':', alpha=0.6)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
