    "indices_awkward = np.where(event_has_signal)[0]\n",
    "\n",
    "assert np.array_equal(indices_numba, indices_awkward), \"DIFEREM!\"\n",
    "print(\"✓ Outputs idênticos — mesmos eventos, mesma ordem\")"
   ]
