   "source": [
    "import awkward as ak\n",
    "import numpy as np\n",
    "\n",
    "# ==============================================================================\n",
    "# IDENTIFICAÇÃO DE MULTI-CANDIDATOS (B0s no mesmo evento)\n",
    "# ==============================================================================\n",
    "\n",
    "# 1. Conta quantos B0s (PDG 511) existem em cada evento\n",
    "n_b0_per_event = ak.sum(pdg_clean == 511, axis=1)\n",
    "\n",
    "# 2. Cria uma máscara para eventos que têm mais de um B0\n",
    "multi_signal_mask = n_b0_per_event > 1\n",
    "\n",
    "# 3. Filtra os dados para ver apenas esses casos\n",
    "events_with_multi_signal = pdg_clean[multi_signal_mask]\n",
    "indices_multi_signal = np.where(ak.to_numpy(multi_signal_mask))[0]\n",
    "\n",
    "# 4. Resultados\n",
    "total_multi = len(events_with_multi_signal)\n",
    "print(f\"Total de eventos processados: {len(pdg_clean)}\")\n",
    "print(f\"Eventos com MAIS DE UM sinal: {total_multi}\")\n",
    "\n",
    "if total_multi > 0:\n",
    "    print(\"\\nExemplo dos primeiros eventos com multi-sinal:\")\n",
    "    print(\"-\" * 50)\n",
    "    for i in range(min(3, total_multi)):\n",
    "        idx_original = indices_multi_signal[i]\n",
    "        n_b0s = n_b0_per_event[idx_original]\n",
    "        print(f\"Evento no índice {idx_original}:\")\n",
    "        print(f\"  Quantidade de B0s: {n_b0s}\")\n",
    "        print(f\"  Conteúdo PDG: {events_with_multi_signal[i].tolist()}\\n\")\n",
    "else:\n",
    "    print(\"\\nNão foram encontrados eventos com mais de um sinal simultâneo.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c5acfafc-aae5-4926-9da3-9a69a60fd01a",
   "metadata": {},
   "source": [
    "# Código usando Loop Python + Numba"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8aafd362-a575-4d03-b9f1-7309024e88ee",
   "metadata": {},
