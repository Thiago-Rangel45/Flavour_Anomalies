   "source": [
    "import awkward as ak\n",
    "import numpy as np\n",
    "\n",
    "# ==============================================================================\n",
    "# VERIFICAÇÃO DE FREQUÊNCIA (PÓS STRICT MATCH)\n",
    "# ==============================================================================\n",
    "\n",
    "# 1. Achatar e converter para NumPy por segurança\n",
    "all_pdgs_1d = ak.to_numpy(ak.flatten(pdg_clean))\n",
    "\n",
    "# 2. Encontrar os valores únicos e contar quantas vezes cada um aparece\n",
    "unique_pdgs, counts = np.unique(all_pdgs_1d, return_counts=True)\n",
    "\n",
    "# 3. Ordenar os resultados do mais frequente para o menos frequente\n",
    "sorted_indices = np.argsort(-counts)\n",
    "\n",
    "# Dicionário auxiliar para deixar a leitura amigável\n",
    "pdg_names = {\n",
    "    511: \"B0\",\n",
    "    313: \"K*0\",\n",
    "    321: \"K+\",\n",
    "    -211: \"pi-\",\n",
    "    13: \"mu-\",\n",
    "    -13: \"mu+\",\n",
    "    22: \"gamma (FSR)\"\n",
    "}\n",
    "\n",
    "# 4. Encontrar o total de B0s para usar como base da proporção\n",
    "if 511 in unique_pdgs:\n",
    "    num_candidates = counts[unique_pdgs == 511][0]\n",
    "else:\n",
    "    num_candidates = 1 # Evita divisão por zero se a array vier vazia\n",
    "\n",
    "# 5. Imprimir os resultados de forma formatada\n",
    "print(f\"Análise de Frequência para {num_candidates} candidatos B0 válidos:\")\n",
    "print(\"-\" * 75)\n",
    "print(f\"{'PDG ID':<10} | {'Partícula':<15} | {'Total Encontrado':<18} | {'Média por B0'}\")\n",
    "print(\"-\" * 75)\n",
    "\n",
    "for idx in sorted_indices:\n",
    "    pdg = unique_pdgs[idx]\n",
    "    count = counts[idx]\n",
    "    \n",
    "    # Busca o nome no dicionário; se não achar, escreve \"Desconhecido\"\n",
    "    name = pdg_names.get(pdg, \"Desconhecido\")\n",
    "    \n",
    "    # Calcula a média por candidato B0 (deve ser cravado 1.00 para o sinal)\n",
    "    avg_per_cand = count / num_candidates\n",
    "    \n",
    "    print(f\"{pdg:<10} | {name:<15} | {count:<18} | {avg_per_cand:.2f}\")\n",
    "\n",
    "print(\"-\" * 75)"
   ]
  },
