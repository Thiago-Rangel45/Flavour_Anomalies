   "id": "a1cc12bb-f942-4ed1-8d08-a5541e0b0931",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Abrindo arquivo e montando grafo lazy...\n",
      "Número de partições: 1\n",
      "\n",
      "Executando com barra de progresso...\n",
      "[########################################] | 100% Completed | 103.04 ms\n",
      "[                                        ] | 0% Completed | 4.76 s ms"
     ]
    }
   ],
   "source": [
    "import uproot\n",
    "import awkward as ak\n",
    "import dask_awkward as dak\n",
    "import numpy as np\n",
    "from dask.diagnostics import ProgressBar\n",
    "\n",
    "# ==============================================================================\n",
    "# FUNÇÃO DE TRUTH MATCHING (B0 -> K*0 Psi(2S), Psi(2S) -> gamma mu, gamma mu)\n",
    "# ==============================================================================\n",
    "def apply_strict_truth_match(pdg, mother, **branches):\n",
    "    local_idx = ak.local_index(pdg)\n",
    "\n",
    "    # ------------------------------------------------------------------\n",
    "    # Navegação de parentesco (mãe, avó e bisavó)\n",
    "    # ------------------------------------------------------------------\n",
    "    safe_mom      = ak.where(mother >= 0, mother, 0)\n",
    "    mom_pdg       = pdg[safe_mom]\n",
    "    mom_pdg       = ak.where(mother >= 0, mom_pdg, -999)\n",
    "\n",
    "    safe_grandmom = safe_mom[safe_mom]\n",
    "    grandmom_pdg  = pdg[safe_grandmom]\n",
    "    grandmom_pdg  = ak.where(safe_mom >= 0, grandmom_pdg, -999)\n",
    "\n",
    "    safe_greatgrandmom = safe_mom[safe_grandmom]\n",
    "    greatgrandmom_pdg  = pdg[safe_greatgrandmom]\n",
    "    greatgrandmom_pdg  = ak.where(safe_grandmom >= 0, greatgrandmom_pdg, -999)\n",
    "\n",
    "    # ------------------------------------------------------------------\n",
    "    # Atribuição do ancestral B0 para cada partícula\n",
    "    # ------------------------------------------------------------------\n",
    "    B_ancestor_idx = ak.full_like(pdg, -1)\n",
    "\n",
    "    # O próprio B0 aponta para si mesmo\n",
    "    B_ancestor_idx = ak.where(\n",
    "        (pdg == 511),\n",
    "        local_idx,\n",
    "        B_ancestor_idx\n",
    "    )\n",
    "    # K*0 filho direto do B0\n",
    "    B_ancestor_idx = ak.where(\n",
    "        (pdg == 313) & (mom_pdg == 511),\n",
    "        safe_mom,\n",
    "        B_ancestor_idx\n",
    "    )\n",
    "    # Psi(2S) filho direto do B0\n",
    "    B_ancestor_idx = ak.where(\n",
    "        (pdg == 100443) & (mom_pdg == 511),\n",
    "        safe_mom,\n",
    "        B_ancestor_idx\n",
    "    )\n",
    "    # γ filho do Psi(2S), neto do B0\n",
    "    B_ancestor_idx = ak.where(\n",
    "        (pdg == 22) & (mom_pdg == 100443) & (grandmom_pdg == 511),\n",
    "        safe_grandmom,\n",
    "        B_ancestor_idx\n",
    "    )\n",
    "\n",
    "    # K+: filho do K*0, neto do B0\n",
    "    is_K  = (pdg == 321)  & (mom_pdg == 313) & (grandmom_pdg == 511)\n",
    "    # π-: filho do K*0, neto do B0\n",
    "    is_pi = (pdg == -211) & (mom_pdg == 313) & (grandmom_pdg == 511)\n",
    "\n",
    "    B_ancestor_idx = ak.where(is_K,  safe_grandmom, B_ancestor_idx)\n",
    "    B_ancestor_idx = ak.where(is_pi, safe_grandmom, B_ancestor_idx)\n",
    "\n",
    "    # μ-: filho do γ, neto do Psi(2S), bisneto do B0\n",
    "    is_mu_m = (\n",
    "        (pdg == 13)  &\n",
    "        (mom_pdg == 22) &\n",
    "        (grandmom_pdg == 100443) &\n",
    "        (greatgrandmom_pdg == 511)\n",
    "    )\n",
    "    # μ+: filho do γ, neto do Psi(2S), bisneto do B0\n",
    "    is_mu_p = (\n",
    "        (pdg == -13) &\n",
    "        (mom_pdg == 22) &\n",
    "        (grandmom_pdg == 100443) &\n",
    "        (greatgrandmom_pdg == 511)\n",
    "    )\n",
    "\n",
    "    B_ancestor_idx = ak.where(is_mu_m | is_mu_p, safe_greatgrandmom, B_ancestor_idx)\n",
    "\n",
    "    # ------------------------------------------------------------------\n",
    "    # Validação cruzada: o ancestral B0 de cada partícula deve ter gerado\n",
    "    # EXATAMENTE 1 K*0, 1 K+, 1 π-, 1 Psi(2S), 1 μ-, 1 μ+\n",
    "    # ------------------------------------------------------------------\n",
    "    anc_kstar = B_ancestor_idx[(pdg == 313)    & (mom_pdg == 511)]\n",
    "    anc_psi2s = B_ancestor_idx[(pdg == 100443) & (mom_pdg == 511)]\n",
    "    anc_K     = B_ancestor_idx[is_K]\n",
    "    anc_pi    = B_ancestor_idx[is_pi]\n",
    "    anc_mu_m  = B_ancestor_idx[is_mu_m]\n",
    "    anc_mu_p  = B_ancestor_idx[is_mu_p]\n",
    "\n",
    "    p_anc = B_ancestor_idx[:, :, np.newaxis]\n",
    "\n",
    "    has_1_kstar = ak.sum(p_anc == anc_kstar[:, np.newaxis, :], axis=-1) == 1\n",
    "    has_1_psi2s = ak.sum(p_anc == anc_psi2s[:, np.newaxis, :], axis=-1) == 1\n",
    "    has_1_K     = ak.sum(p_anc == anc_K[:, np.newaxis, :],     axis=-1) == 1\n",
    "    has_1_pi    = ak.sum(p_anc == anc_pi[:, np.newaxis, :],    axis=-1) == 1\n",
    "    has_1_mu_m  = ak.sum(p_anc == anc_mu_m[:, np.newaxis, :],  axis=-1) == 1\n",
    "    has_1_mu_p  = ak.sum(p_anc == anc_mu_p[:, np.newaxis, :],  axis=-1) == 1\n",
    "\n",
    "    is_valid_chain = (\n",
    "        has_1_kstar & has_1_psi2s &\n",
    "        has_1_K     & has_1_pi    &\n",
    "        has_1_mu_m  & has_1_mu_p\n",
    "    )\n",
    "\n",
    "    particle_mask    = is_valid_chain & (B_ancestor_idx >= 0)\n",
    "    event_has_signal = ak.sum(particle_mask, axis=1) > 0\n",
    "\n",
    "    results = {'pdg': pdg[particle_mask][event_has_signal]}\n",
    "    for name, array in branches.items():\n",
    "        results[name] = array[particle_mask][event_has_signal]\n",
    "\n",
    "    return results\n",
    "\n",
    "# ==============================================================================\n",
    "# WRAPPER POR PARTIÇÃO (para dask_awkward)\n",
    "# ==============================================================================\n",
    "def process_partition(pdg_part, mother_part, mass_part):\n",
    "    result = apply_strict_truth_match(\n",
    "        pdg    = pdg_part,\n",
    "        mother = mother_part,\n",
    "        mass   = mass_part\n",
    "    )\n",
    "    return ak.Array({'pdg': result['pdg'], 'mass': result['mass']})\n",
    "\n",
    "# ==============================================================================\n",
    "# SCRIPT PRINCIPAL\n",
    "# ==============================================================================\n",
    "file_path = \"/eos/user/t/tdeandra/skim_outputs/Merged_Eras/Merged_mc_psi2s_2022.root\"\n",
    "\n",
    "print(\"Abrindo arquivo e montando grafo lazy...\")\n",
    "\n",
    "arrays = uproot.dask(\n",
    "    {file_path: \"Events\"},\n",
    "    expressions=[\n",
    "        \"BPHGenPart_pdgId\",\n",
    "        \"BPHGenPart_genPartIdxMother\",\n",
    "        \"BPHGenPart_mass\"\n",
    "    ],\n",
    "    library=\"ak\"\n",
    ")\n",
    "\n",
    "raw_pdg    = arrays[\"BPHGenPart_pdgId\"]\n",
    "raw_mother = arrays[\"BPHGenPart_genPartIdxMother\"]\n",
    "raw_mass   = arrays[\"BPHGenPart_mass\"]\n",
    "\n",
    "print(f\"Número de partições: {raw_pdg.npartitions}\")\n",
    "\n",
    "result_lazy = dak.map_partitions(\n",
    "    process_partition,\n",
    "    raw_pdg,\n",
    "    raw_mother,\n",
    "    raw_mass\n",
    ")\n",
    "\n",
    "print(\"\\nExecutando com barra de progresso...\")\n",
    "with ProgressBar():\n",
    "    result = result_lazy.compute()\n",
    "\n",
    "pdg_clean  = result[\"pdg\"]\n",
    "mass_clean = result[\"mass\"]\n",
    "\n",
    "print(f\"\\nTotal de eventos de SINAL retidos: {len(pdg_clean)}\")\n",
    "\n",
    "for i in range(min(5, len(pdg_clean))):\n",
    "    print(f\"\\nEvento {i}:\")\n",
    "    print(f\"  PDG  : {pdg_clean[i].tolist()}\")\n",
    "    print(f\"  Mass : {mass_clean[i].tolist()}\")"
   ]
  },
