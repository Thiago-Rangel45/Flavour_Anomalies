   "id": "ab82e43e-45b8-4d26-9a58-cc6d1928e092",
   "metadata": {},
   "outputs": [],
   "source": [
    "# API correta para carregar com dask_awkward\n",
    "arrays = uproot.dask(\n",
    "    {file_path: \"Events\"},\n",
    "    expressions=[\"BPHGenPart_pdgId\", \"BPHGenPart_genPartIdxMother\", \"BPHGenPart_mass\"],\n",
    "    library=\"ak\"\n",
    ")\n",
    "\n"
   ]
  }
