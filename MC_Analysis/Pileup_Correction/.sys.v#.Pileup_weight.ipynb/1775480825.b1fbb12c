    "pad3.Draw()\n",
    "\n",
    "pad3.cd()\n",
    "h_mc_corrigido.GetYaxis().SetTitle(\"Normalized Events\")\n",
    "h_mc_corrigido.GetYaxis().SetTitleSize(0.04)\n",
