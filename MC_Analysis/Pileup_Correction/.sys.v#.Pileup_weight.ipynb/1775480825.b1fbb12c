   "source": [
    "nbins = hist_mc_cmssw.GetNbinsX()\n",
    "bins = np.empty([nbins])\n",
    "mc_weight_cmssw = np.empty([nbins])\n",
    "\n",
    "for i in range(0, nbins):\n",
    "    weight = hist_ratio.GetBinContent(i)\n",
    "    bins[i] = i\n",
    "    mc_weight_cmssw[i] = weight"
   ]
  },
