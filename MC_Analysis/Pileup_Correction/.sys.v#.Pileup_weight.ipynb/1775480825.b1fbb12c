    "\n",
    "line = ROOT.TLine(h_mc_corrigido.GetXaxis().GetXmin(), 1, h_mc_corrigido.GetXaxis().GetXmax(), 1)\n",
    "line.SetLineColor(ROOT.kGray+2)\n",
    "line.SetLineStyle(2)\n",
