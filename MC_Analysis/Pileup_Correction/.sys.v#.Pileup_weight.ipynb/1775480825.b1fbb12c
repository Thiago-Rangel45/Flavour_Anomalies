    "h_mc_corrigido.SetLineColor(ROOT.kBlue)\n",
    "h_mc_corrigido.SetLineWidth(2)\n",
    "h_mc_corrigido.SetFillColorAlpha(ROOT.kBlue, 0.8)\n",
