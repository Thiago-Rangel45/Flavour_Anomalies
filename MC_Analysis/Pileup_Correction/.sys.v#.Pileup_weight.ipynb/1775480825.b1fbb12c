   "source": [
    "pesos_pileup = np.load('mc_weight_cmssw.npy')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f5b385a1-7138-4bd7-b0bf-a6a359d47993",
   "metadata": {},
   "outputs": [],
   "source": [
    "h_dados = file_data.Get(\"pileup\").Clone(\"h_dados_clone\")\n",
    "h_mc_original = file_mc_cmssw.Get(\"pileup_hist\").Clone(\"h_mc_clone\")\n",
    "h_mc_corrigido = h_mc_original.Clone(\"h_mc_corrigido\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bcacd0d4-b1d2-4412-bf8f-f05e22e8c972",
   "metadata": {},
   "outputs": [],
   "source": [
    "for i in range(1, h_mc_corrigido.GetNbinsX() + 1):\n",
    "    conteudo_original = h_mc_original.GetBinContent(i)\n",
    "    erro_original = h_mc_original.GetBinError(i)\n",
    "    peso = pesos_pileup[i-1]\n",
    "    \n",
    "    h_mc_corrigido.SetBinContent(i, conteudo_original * peso)\n",
    "    h_mc_corrigido.SetBinError(i, erro_original * peso)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ebee972e-59d4-4392-9bff-f4f33e86e6cb",
   "metadata": {},
   "outputs": [],
   "source": [
    "h_dados.Scale(1.0 / h_dados.Integral())\n",
    "h_mc_original.Scale(1.0 / h_mc_original.Integral())\n",
    "h_mc_corrigido.Scale(1.0 / h_mc_corrigido.Integral())\n",
