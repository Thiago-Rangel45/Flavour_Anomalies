   "source": [
    "## Pileup usando Poisson"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "09a190ee-7de8-4a5b-bdf6-fc65a657a2a3",
   "metadata": {},
   "outputs": [],
   "source": [
    "file_data = ROOT.TFile(\"Pileup_data/MyDataPileupHistogram.root\")\n",
    "file_mc_cmssw = ROOT.TFile(\"Pileup_data/pileup_histogram.root\")\n",
    "\n",
    "hist_data = file_data.Get(\"pileup\")\n",
    "hist_mc_cmssw = file_mc_cmssw.Get(\"pileup_hist\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dd44a5ae-be3b-4e91-85b7-e3acd51cd4ab",
   "metadata": {},
   "outputs": [],
   "source": [
    "if hist_data.GetNbinsX() != hist_mc_cmssw.GetNbinsX():\n",
    "    if hist_data.GetNbinsX() > hist_mc_cmssw.GetNbinsX():\n",
    "        hist_data.Rebin(hist_data.GetNbinsX() // hist_mc_cmssw.GetNbinsX())\n",
    "    else:\n",
    "        hist_mc_cmssw.Rebin(hist_mc_cmssw.GetNbinsX() // hist_data.GetNbinsX())\n",
    "\n",
    "print(f'Número de bins no histograma de dados: {hist_data.GetNbinsX()}')\n",
    "print(f'Número de bins no histograma de MC: {hist_mc_cmssw.GetNbinsX()}')\n",
    "\n",
    "\n",
    "hist_data.Scale(1.0 / hist_data.Integral())\n",
    "hist_mc_cmssw.Scale(1.0 / hist_mc_cmssw.Integral())\n",
    "\n",
    "print(f'Área no histograma de dados: {hist_data.Integral()}')\n",
    "print(f'Área no histograma de MC: {hist_mc_cmssw.Integral()}')"
   ]
  },
